# http://localhost:<port>/tasks
- complementary "Sidebar":
  - button "Search"
  - button "Expand sidebar"
  - navigation "Primary":
    - link "Tasks":
      - /url: /tasks
    - link "Terminal":
      - /url: /terminal
    - link "Computer":
      - /url: /computer
    - link "Browser":
      - /url: /browser
  - navigation "Bots"
  - button "Account and navigation": D
- main:
  - heading "Tasks" [level=1]
  - text: Your to-dos. Bots can manage these from chat too.
  - tablist "Task filters":
    - tab "Today0" [selected]
    - tab "Upcoming0"
    - tab "Completed0"
  - textbox "New task title":
    - /placeholder: Add a task for today (try “tomorrow 5pm !high”)
  - button "Add task" [disabled]: Add
  - paragraph: All clear
  - paragraph: Nothing due today. Enjoy the calm, or plan ahead.
- region "Notifications alt+T"
