# http://localhost:<port>/login
- text: tiny-agents
- heading "Welcome back" [level=1]
- paragraph: Sign in to your account to continue.
- text: "Demo credentials: demo@example.com / demo@example.com Email"
- textbox "Email":
  - /placeholder: you@example.com
  - text: demo@example.com
- text: Password
- textbox "Password":
  - /placeholder: ••••••••
  - text: not-the-password
- button "Sign In"
- text: or
- button "Sign in with passkey"
- heading "Your team of always-on agents." [level=2]
- paragraph: Every contact is an AI bot you chat with. Durable conversations that survive refreshes, crashes and redeploys.
- list:
  - listitem:
    - paragraph: Bots that remember
    - paragraph: One continuous conversation per bot, kept forever.
  - listitem:
    - paragraph: Durable by default
    - paragraph: Replies resume mid-stream after restarts.
  - listitem:
    - paragraph: Yours alone
    - paragraph: Single-owner app with passkey or password login.
- region "Notifications alt+T":
  - list:
    - listitem: Login Failed Invalid email or password.
