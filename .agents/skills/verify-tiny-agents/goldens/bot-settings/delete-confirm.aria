# http://localhost:<port>/chats/<id1>
- region "Notifications alt+T"
- dialog "Edit Renamed Bot fixed":
  - heading "Edit Renamed Bot fixed" [level=2]
  - paragraph: Prompt and model changes apply from the next turn; history is kept.
  - tablist:
    - tab "Profile" [selected]
    - tab "Tools"
    - tab "Skills"
    - tab "Sharing"
  - tabpanel "Profile":
    - text: Name
    - textbox "Name":
      - /placeholder: e.g. Research helper
      - text: Renamed Bot fixed
    - text: Description
    - textbox "Description":
      - /placeholder: One line, shown under the name
      - text: Plans trips fixed
    - text: Model
    - button "Test Model (faux)"
    - text: System prompt
    - textbox "System prompt":
      - /placeholder: Who is this bot? How should it reply?
      - text: You are a terse travel agent (fixed).
  - paragraph: Delete Renamed Bot fixed? This cannot be undone.
  - button "Cancel"
  - button "Delete bot"
  - button "Close"
