# http://localhost:<port>/chats/<id1>
- complementary "Sidebar":
  - link "tiny-agents":
    - /url: /chats
  - button "Search"
  - button "Collapse sidebar"
  - navigation "Primary":
    - link "Tasks":
      - /url: /tasks
    - link "Terminal":
      - /url: /terminal
    - link "Computer":
      - /url: /computer
    - link "Browser":
      - /url: /browser
  - region "Bots":
    - heading "Bots" [level=2]
    - button "New bot"
    - list:
      - listitem:
        - link "Attach Bot fixed, replying":
          - /url: /chats/<id1>
          - text: Attach Bot fixed
          - status "Replying"
        - button "Attach Bot fixed actions"
  - button "Account and navigation": D Demo User
- main:
  - heading "Attach Bot fixed menu" [level=1]:
    - button "Attach Bot fixed menu": Attach Bot fixed
  - button "Open live view"
  - button "Start a new chat"
  - region "Messages":
    - log:
      - text: Today
      - button "Enlarge shot-fixed.png":
        - img "shot-fixed.png"
      - paragraph: what is this fixed?
      - button "Copy message"
      - time: 06:30 AM
      - paragraph: "Echo: what is this fixed?"
      - paragraph:
        - button "image attach"
  - button "Jump to the latest message": Scroll to end
  - textbox "Message Attach Bot fixed"
  - button "Add files or mention a bot"
  - button "Model": Test Model (faux)
  - button "Stop generating"
  - paragraph: Enter steers · Alt+Enter queues · Esc stops
- region "Notifications alt+T"
