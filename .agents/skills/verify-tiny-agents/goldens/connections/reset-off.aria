# http://localhost:<port>/connections/<id1>
- complementary "Sidebar":
  - link "tiny-agents":
    - /url: /chats
  - button "Search"
  - button "Collapse sidebar"
  - navigation "Primary":
    - link "Tasks":
      - /url: /tasks
    - link "Terminal":
      - /url: /terminal
    - link "Computer":
      - /url: /computer
    - link "Browser":
      - /url: /browser
  - region "Bots":
    - heading "Bots" [level=2]
    - button "New bot"
    - list:
      - listitem:
        - link "MCP Bot fixed":
          - /url: /chats/<id2>
        - button "MCP Bot fixed actions"
  - button "Account and navigation": D Demo User
- main:
  - navigation "breadcrumb":
    - list:
      - listitem:
        - link "Connections":
          - /url: /connections
      - listitem: Verify MCP fixed
  - heading "Verify MCP fixed" [level=1]
  - text: Connected http://127.0.0.1:<port>/mcp
  - heading "Status" [level=3]
  - button "Reconnect"
  - text: Connected API key header (x-api-key) · added a few seconds ago
  - heading "Tools" [level=2]
  - text: 2 tools · 1 off
  - paragraph: Tools turned off here are hidden from every bot. Open a tool for its schema and a playground.
  - list:
    - listitem:
      - link "echo Echo a value back read-only":
        - /url: /connections/<id1>/tools/echo
        - paragraph: echo
        - paragraph: Echo a value back
        - text: read-only
      - switch "Let bots use echo" [checked]
    - listitem:
      - link "reset Reset the counter":
        - /url: /connections/<id1>/tools/reset
        - paragraph: reset
        - paragraph: Reset the counter
      - switch "Let bots use reset"
  - heading "Used by bots" [level=2]
  - text: 0 bots
  - list:
    - listitem:
      - checkbox "Use Verify MCP fixed tools in MCP Bot fixed"
      - text: MCP Bot fixed
  - heading "Danger zone" [level=2]
  - paragraph: Remove connection
  - paragraph: Removes the server and its cached tools.
  - button "Remove"
- region "Notifications alt+T":
  - list:
    - listitem: Connection added
