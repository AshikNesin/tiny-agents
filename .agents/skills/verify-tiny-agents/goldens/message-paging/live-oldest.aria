# http://localhost:<port>/chats/<id1>
- complementary "Sidebar":
  - link "tiny-agents":
    - /url: /chats
  - button "Search"
  - button "Collapse sidebar"
  - navigation "Primary":
    - link "Tasks":
      - /url: /tasks
    - link "Terminal":
      - /url: /terminal
    - link "Computer":
      - /url: /computer
    - link "Browser":
      - /url: /browser
  - region "Bots":
    - heading "Bots" [level=2]
    - button "New bot"
    - list:
      - listitem:
        - link "Paging Bot fixed":
          - /url: /chats/<id1>
          - text: "Paging Bot fixed now Echo: msg 060 fixed"
        - button "Paging Bot fixed actions"
  - button "Account and navigation": D Demo User
- main:
  - heading "Paging Bot fixed menu" [level=1]:
    - button "Paging Bot fixed menu": Paging Bot fixed
  - button "Open live view"
  - button "Start a new chat"
