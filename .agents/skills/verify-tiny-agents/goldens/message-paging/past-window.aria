# http://localhost:<port>/chats/<id1>/history/<id2>
- complementary "Sidebar":
  - link "tiny-agents":
    - /url: /chats
  - button "Search"
  - button "Collapse sidebar"
  - navigation "Primary":
    - link "Tasks":
      - /url: /tasks
    - link "Terminal":
      - /url: /terminal
    - link "Computer":
      - /url: /computer
    - link "Browser":
      - /url: /browser
  - region "Bots":
    - heading "Bots" [level=2]
    - button "New bot"
    - list:
      - listitem:
        - link "Paging Bot fixed":
          - /url: /chats/<id1>
        - button "Paging Bot fixed actions"
  - button "Account and navigation": D Demo User
