# http://localhost:<port>/settings/configuration
- main:
  - link "Back to tiny-agents":
    - /url: /chats
  - button "Search (⌘K)"
  - complementary:
    - combobox "Search settings"
    - navigation "Settings sections":
      - text: Personal
      - list:
        - listitem:
          - link "Account":
            - /url: /settings/account
        - listitem:
          - link "Appearance":
            - /url: /settings/appearance
        - listitem:
          - link "Security":
            - /url: /settings/security
      - text: App
      - list:
        - listitem:
          - link "Models":
            - /url: /settings/models
        - listitem:
          - link "Notifications":
            - /url: /settings/notifications
        - listitem:
          - link "People":
            - /url: /settings/people
        - listitem:
          - link "Configuration":
            - /url: /settings/configuration
        - listitem:
          - link "Updates":
            - /url: /settings/updates
  - main:
    - heading "Configuration" [level=1]
    - text: App-wide settings, shared by every user. Application configuration stored as JSON.
    - button "Refresh"
    - button "Add setting"
    - searchbox "Search settings…"
    - button "verify.setting.fixed made by verify fixed"
    - heading "verify.setting.fixed" [level=3]
    - text: Edit the configuration below and save your changes.
    - button "Delete"
    - text: Description
    - textbox "Description":
      - /placeholder: Brief description of this setting
      - text: made by verify fixed
    - text: JSON value
    - textbox
    - button "Save changes"
- region "Notifications alt+T"
