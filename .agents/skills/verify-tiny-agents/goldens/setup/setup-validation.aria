# http://localhost:<port>/setup
- text: tiny-agents
- heading "Create your account" [level=1]
- paragraph: No users exist yet. The account you create here signs you in, and this page closes once it exists.
- text: Name (optional)
- textbox "Name (optional)":
  - /placeholder: Ada Lovelace
- text: Email
- textbox "Email" [invalid]:
  - /placeholder: you@example.com
  - text: a@b
- paragraph: Invalid email address
- text: Password
- textbox "Password" [invalid]:
  - /placeholder: ••••••••
  - text: "123"
- paragraph: Password must be at least 6 characters
- text: Confirm password
- textbox "Confirm password" [invalid]:
  - /placeholder: ••••••••
  - text: "456"
- paragraph: Passwords do not match
- button "Create account"
- region "Notifications alt+T"
- button "Feedback":
  - img
