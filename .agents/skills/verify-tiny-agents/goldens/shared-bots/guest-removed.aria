# http://localhost:<port>/settings/people
- main:
  - link "Back to tiny-agents":
    - /url: /chats
  - button "Search (⌘K)"
  - complementary:
    - combobox "Search settings"
    - navigation "Settings sections":
      - text: Personal
      - list:
        - listitem:
          - link "Account":
            - /url: /settings/account
        - listitem:
          - link "Appearance":
            - /url: /settings/appearance
        - listitem:
          - link "Security":
            - /url: /settings/security
      - text: App
      - list:
        - listitem:
          - link "Models":
            - /url: /settings/models
        - listitem:
          - link "Notifications":
            - /url: /settings/notifications
        - listitem:
          - link "People":
            - /url: /settings/people
        - listitem:
          - link "Configuration":
            - /url: /settings/configuration
        - listitem:
          - link "Updates":
            - /url: /settings/updates
  - main:
    - heading "People" [level=1]
    - text: Guests who can use the shared bots.
    - heading "Add a guest" [level=3]
    - text: A guest chats with the bots you share with them, in the same chat as you, and can use Code. Everything else stays yours. Name
    - textbox "Name"
    - text: Email
    - textbox "Email"
    - text: Password
    - textbox "Password"
    - button "Add guest"
    - heading "Guests" [level=3]
    - text: Share a bot with a guest from its settings → Sharing.
    - paragraph: No guests yet.
- region "Notifications alt+T"
- button "Feedback":
  - img
