# http://localhost:<port>/chats/<id1>
- complementary "Sidebar":
  - link "tiny-agents":
    - /url: /chats
  - button "Search"
  - button "Collapse sidebar"
  - navigation "Primary":
    - link "Tasks":
      - /url: /tasks
    - link "Terminal":
      - /url: /terminal
    - link "Computer":
      - /url: /computer
    - link "Browser":
      - /url: /browser
  - region "Bots":
    - heading "Bots" [level=2]
    - button "New bot"
    - list:
      - listitem:
        - link "Shared Bot fixed":
          - /url: /chats/<id1>
          - text: "Shared Bot fixed now Echo: Demo User: owner hello fixed"
        - button "Shared Bot fixed actions"
      - listitem:
        - link "Private Bot fixed":
          - /url: /chats/<id2>
        - button "Private Bot fixed actions"
  - button "Account and navigation": D Demo User
- main:
  - heading "Shared Bot fixed menu Shared" [level=1]:
    - button "Shared Bot fixed menu": Shared Bot fixed
    - text: Shared
  - button "Open live view"
  - button "Start a new chat"
  - region "Messages":
    - log:
      - text: Today
      - paragraph: owner hello fixed
      - button "Copy message"
      - time: 06:30 AM
      - paragraph: "Echo: Demo User: owner hello fixed"
      - button "Copy message"
      - time: 06:30 AM
  - button "Jump to the latest message": Scroll to end
  - textbox "Message Shared Bot fixed"
  - button "Add files or mention a bot"
  - button "Model": Test Model (faux)
  - button "Send message" [disabled]
  - paragraph: Type @ to tag another bot
- region "Notifications alt+T"
