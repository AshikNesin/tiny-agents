# http://localhost:<port>/skills/<id1>
- complementary "Sidebar":
  - link "tiny-agents":
    - /url: /chats
  - button "Search"
  - button "Collapse sidebar"
  - navigation "Primary":
    - link "Tasks":
      - /url: /tasks
    - link "Terminal":
      - /url: /terminal
    - link "Computer":
      - /url: /computer
    - link "Browser":
      - /url: /browser
  - region "Bots":
    - heading "Bots" [level=2]
    - button "New bot"
    - paragraph: No bots yet.
  - button "Account and navigation": D Demo User
- main:
  - navigation "breadcrumb":
    - list:
      - listitem:
        - link "Skills":
          - /url: /skills
      - listitem: verify-skill-fixed
  - heading "verify-skill-fixed" [level=1]
  - button "Delete"
  - button "Save changes" [disabled]
  - heading "Details" [level=3]
  - text: Name
  - textbox "Name" [disabled]: verify-skill-fixed
  - paragraph: Bots reference a skill by its name, so it can't be changed.
  - text: Description
  - textbox "Description": Made by verify fixed
  - paragraph: Shown when the bot decides whether to load this skill.
  - heading "Used by bots" [level=2]
  - text: 0 of 1
  - paragraph: No bot loads this skill yet. Tick the bots that should have it.
  - checkbox "Use verify-skill-fixed with Skill Bot fixed"
  - text: Skill Bot fixed
  - heading "Instructions" [level=3]
  - tablist:
    - tab "Edit" [selected]
    - tab "Preview"
  - tabpanel "Edit":
    - textbox "Skill instructions (markdown)":
      - /placeholder: Write the skill's instructions in markdown…
      - text: "# Step one fixed Do the thing."
  - heading "Files" [level=2]
  - text: 0 bundled
  - paragraph: No bundled files.
- region "Notifications alt+T":
  - list:
    - listitem: Skill created
