      - listitem:
        - button "Go to root folder"
  - heading "Storage" [level=1]
  - text: Browse and manage your files and folders
  - button "Refresh files"
  - button "Upload"
  - button "New Folder"
  - paragraph: No files found
  - paragraph: This folder is empty. Upload files or create a new folder to get started.
- region "Notifications alt+T":
