# Copy to `.env` for local overrides. Every variable has a development default,
# so a fresh checkout boots with no .env at all. Production (NODE_ENV=production)
# requires the secrets marked [prod-required] — the server refuses to start
# with the development fallbacks. On Cloudflare set these as Worker secrets/vars.

NODE_ENV=development

# SQLite file for the Node runtime (Workers bind D1 instead). Unset: data/dev.db
# in development, /data/prod.db in production.
# DATABASE_URL=file:./data/dev.db
# Node only: uploads folder. Unset: ./local/uploads in development,
# /data/uploads (next to the database) in production.
# UPLOADS_DIR=./local/uploads
PORT=3000

# [prod-required] At least 32 characters.
JWT_SECRET_KEY=
# [prod-required] Header value for admin-only endpoints (X-Admin-Auth-Key).
ADMIN_AUTH_KEY=

# Passkeys (WebAuthn) relying party. [prod-required] RP_ID + ORIGIN must match
# your public domain, e.g. RP_ID=app.example.com ORIGIN=https://app.example.com
RP_NAME=Groot
RP_ID=localhost
ORIGIN=http://localhost:3000

# Comma-separated allow-list. Empty allows the requesting origin.
CORS_ALLOWED_ORIGINS=
# trace | debug | info | warn | error | fatal | silent (default: debug in dev, info in prod)
LOG_LEVEL=

# Error tracking (optional), read through config.sentry. SENTRY_RELEASE must
# match the release the build uploaded source maps under.
SENTRY_DSN=
SENTRY_RELEASE=
# Build-time only (scripts/build.mjs, vite.config.ts): source map upload and
# the release name. Not validated at runtime.
SENTRY_ORG=
SENTRY_AUTH_TOKEN=
SENTRY_PROJECT=
SOURCE_COMMIT=

# AI (optional): Cloudflare AI Gateway and a default model, read by app code
# that builds an @groot/ai client.
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_GATEWAY_ID=
DEFAULT_MODEL=
# Provider keys are read by the provider SDKs straight from process.env when no
# apiKey is passed, so they are not in envSchema.
# OPENAI_API_KEY=

# Push notifications (docs/features/notifications.md). Both empty = off. The
# user (or group) key from pushover.net, and an application token.
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=

# ──────────────────────────────────────────────────────────────────────
# tiny-agents (validated in apps/web/src/server/env.ts or read where used)
# ──────────────────────────────────────────────────────────────────────

# Production keeps tiny-agents' database at file:/data/app.db when
# DATABASE_URL is unset (groot's default would be /data/prod.db). Uploads live
# beside it (<dir>/uploads) unless UPLOADS_DIR is set.

# pi-durable agent store: a plain path or a file: URL. Default /data/agent.db
# in production, ./data/agent.db in development, ./tmp/agent-test.db in tests.
AGENT_DB_PATH=

# Encrypts MCP connection secrets and local vault items at rest (AES-256-GCM).
# Any long random string (`openssl rand -base64 32`). Required before adding a
# connection with auth or a local vault item; changing it makes stored secrets
# unreadable.
SECRETS_KEY=

# Sandbox VM bots run commands, the browser and terminal on (issue #1). Empty
# in development = no sandbox; production defaults to tiny-agents-vm.
SANDBOX_HOST=
SANDBOX_PORT=22
SANDBOX_USER=exedev
# Outbound allowlist for sandbox commands (hosts, IPs or CIDRs, comma-separated).
SANDBOX_EGRESS_ALLOWLIST=

# AI gateway extras: an alternate front door, BYOK providers (JSON array) and an
# optional model allowlist (comma-separated ids).
GATEWAY_BASE_URL=
GATEWAY_CUSTOM_PROVIDERS=
GATEWAY_MODEL_ALLOWLIST=

# Vision side-call for bots whose model cannot see images (issue #17).
VISION_MODEL=
VISION_BASE_URL=
VISION_API_KEY=
# Seconds. Default 90.
VISION_TIMEOUT=

# Auto-review classifier (issue #65). Empty = @cf/cloudflare/clef; the API key
# falls back to CLOUDFLARE_API_KEY.
CLASSIFIER_MODEL=
CLASSIFIER_API_KEY=

# TinyFish search and fetch (web_search / web_fetch hidden without it).
TINYFISH_API_KEY=

# Vault (issue #56): 1Password Connect holds the secrets bots use. Without a
# host the vault uses the local backend only (encrypted with SECRETS_KEY).
OP_CONNECT_HOST=
OP_CONNECT_VAULT_ID=
# Read access to that vault only (agent runtime).
OP_CONNECT_TOKEN=
# Read + write access to the same vault only (owner Vault UI).
OP_CONNECT_ADMIN_TOKEN=

# Side-call models: memory capture (issue #22) and past-chat titles (issue #101).
MEMORY_CAPTURE_MODEL=
CHAT_TITLE_MODEL=

# Browser toolkit (issue #24). Explicit binary path, idle close (minutes),
# streamed pixel density (1 or 2), and internal hosts the browser may reach.
BROWSER_EXECUTABLE_PATH=
BROWSER_IDLE_MINUTES=10
BROWSER_SCALE=2
BROWSER_ALLOWED_PRIVATE_HOSTS=

# Computer toolkit (issue #108): an XFCE desktop per browser profile on the
# sandbox VM (needs SANDBOX_HOST). Fixed desktop size the model sees 1:1
# (default 1280x800), idle close (minutes), and Debian packages the first run
# installs besides the desktop (e.g. "libreoffice-calc, gimp").
COMPUTER_DESKTOP_SIZE=
COMPUTER_IDLE_MINUTES=10
COMPUTER_EXTRA_PACKAGES=

# Dev / e2e only: "1" boots a faux model (no network, no keys).
# TINY_AGENTS_FAUX=
