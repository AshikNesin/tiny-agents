# This env file uses @env-spec - see https://varlock.dev/env-spec for more info

# @currentEnv=$NODE_ENV
# @defaultRequired=infer @defaultSensitive=true
# @generateTypes(lang=ts, path=env.d.ts)
# Secrets come from real environment variables only — set them on your
# hosting platform (Coolify/Railway/docker/k8s) or in a git-ignored .env file.
# Ambient env vars always win; dev/test defaults below keep local runs
# zero-config. Production requires the real values (empty fails validation).
#

# @type=enum(development, production, test)
# @required @public
NODE_ENV=development


# Database connection.
# The engine is inferred from the URL scheme — the URL is the only engine knob:
# - postgresql:// or postgres:// → Postgres (@prisma/adapter-pg, pg-boss queue)
# - file:./path, a bare path, or :memory: → SQLite (better-sqlite3, honker queue)
# In development this defaults to a local SQLite file (data/dev.db); set a
# postgresql:// URL to use Postgres instead. In production the default is the
# mounted /data volume (file:/data/app.db) — same volume AGENT_DB_PATH uses.
# A missing /data mount fails fast at boot instead of silently writing a
# local file.
# @type=string
DATABASE_URL=if(forEnv(production), "file:/data/app.db", if(forEnv(test), "file:./tmp/test.db", "file:./data/dev.db"))

# Test database URL (test env only). Same scheme-based inference as DATABASE_URL.
# @type=string
# @required=forEnv(test)
TEST_DATABASE_URL=if(forEnv(test), "file:./tmp/test.db")

# Direct (session-mode) PostgreSQL URL for Prisma migrate/introspection.
# Only relevant for pooled Postgres (e.g. Supabase Supavisor / PgBouncer);
# ignored for sqlite. Optional in dev; required in production when
# DATABASE_URL is pooled.
# @type=string
DATABASE_URL_DIRECT=

# JWT Authentication
# @required
# @type=string(minLength=32)
JWT_SECRET_KEY=if(forEnv(production), "", "your-super-secret-jwt-key-min-32-characters-long")

# Admin Auth Key (for admin-only endpoints)
# @required
ADMIN_AUTH_KEY=if(forEnv(production), "", "your-admin-auth-key-change-in-production")

# Passkey (WebAuthN) relying party. Resolved by config.yml via
# {{ env.RP_NAME }} / {{ env.RP_ID }} / {{ env.ORIGIN }} — config loading
# throws if these are unset, so declare them here with dev defaults.
# In production set them to your real domain (e.g. RP_ID=yourapp.example.com,
# ORIGIN=https://yourapp.example.com).
# NOTE: the relying-party name/id/origin are sent to the client by design
# (WebAuthn registration/login options must include them), so they must not be
# treated as secrets — otherwise varlock's leak scanner blocks those responses.
# @required=forEnv(production) @type=string @public
RP_NAME=if(forEnv(production), "", "Groot")
# @required=forEnv(production) @type=string @public
RP_ID=if(forEnv(production), "", "localhost")
# @required=forEnv(production) @type=url @public
ORIGIN=if(forEnv(production), "", "http://localhost:3000")

# Server port (set automatically by hosting platforms (Coolify, Railway, …))
# @type=number @public
PORT=3000

# Storage configuration
#
# STORAGE_DRIVER selects the files-sdk adapter used by storage core:
# - local (default): filesystem adapter, writes objects under ./local/uploads
#   with a sidecar .meta.json per file. Works in every environment, including
#   production, for single-node deployments.
# - s3: the S3 adapter scoped to AWS_DEFAULT_S3_BUCKET. Requires AWS_* values.
# @type=enum(local, s3) @public
STORAGE_DRIVER=local

# AWS credentials. Only required when STORAGE_DRIVER=s3; ignored otherwise.
# (files-sdk loads S3 creds from the standard AWS chain - env vars, IAM role,
# shared profile - so they are only needed when not running on AWS infra.)
# @required=eq($STORAGE_DRIVER, s3) @type=string
AWS_ACCESS_KEY_ID=
# @required=eq($STORAGE_DRIVER, s3) @type=string
AWS_SECRET_ACCESS_KEY=
# @required=eq($STORAGE_DRIVER, s3) @type=string @public
AWS_REGION=
# @required=eq($STORAGE_DRIVER, s3) @type=string @public
AWS_DEFAULT_S3_BUCKET=

# Sentry DSN for error tracking
# @type=url @public
SENTRY_DSN=
# Sentry Release (used by instrument.ts + build scripts)
# @public
SENTRY_RELEASE=
# Source commit SHA (set by Coolify with "Include Source Commit in Build" enabled)
# @type=string @public
SOURCE_COMMIT=
# Sentry organization slug (build-time only, used by vite.config.ts and scripts/build.mjs)
# @type=string @public
SENTRY_ORG=
# Sentry auth token for source map upload (build-time only)
# @type=string
SENTRY_AUTH_TOKEN=
# Sentry project slug (build-time only, used by scripts/build.mjs; defaults to the package name)
# @type=string @public
SENTRY_PROJECT=


# AI Provider API Key
# An API key is required for AI features. Set it as a real env var on your
# host (or in a git-ignored .env file) — no secret manager involved.
OPENAI_API_KEY=

# Cloudflare AI Gateway. Optional, like OPENAI_API_KEY. The built-in pi-ai
# provider reads these automatically. Only the API key is a secret; account/
# gateway ids appear in URLs and logs by design (they are not guessable
# credentials), so they stay @public — marking them sensitive makes varlock's
# leak guard kill any response that happens to echo the gateway name (e.g. an
# app literally named after its gateway).
# @sensitive
CLOUDFLARE_API_KEY=
# @public
CLOUDFLARE_ACCOUNT_ID=
# @public
CLOUDFLARE_GATEWAY_ID=

# Optional app-level model override. Leave empty to use the app's default.
# @public
DEFAULT_MODEL=


# Groot Resolve (boilerplate-sync conflict resolver)
# `pnpm groot:resolve` shells out to the pi coding agent CLI (https://pi.dev,
# `npm install -g --ignore-scripts @earendil-works/pi-coding-agent`).
# Authentication is pi's: use any provider API key pi supports (e.g.
# ZAI_API_KEY for the ZAI Coding Plan) or `pi` + /login. The optional knobs
# below pin a provider/model instead of pi's configured default. These are
# dev-tooling values (never reach the production server bundle).
# @sensitive
ZAI_API_KEY=
# @public
GROOT_RESOLVE_PROVIDER=
# @public
GROOT_RESOLVE_MODEL=

# @public
CORS_ALLOWED_ORIGINS=

# Push Notifications
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=

# ──────────────────────────────────────────────────────────────────────
# tiny-agents app vars (child-only block; keep at the end — groot sync
# preserves everything after this marker). Upstream vars for the gateway
# (CLOUDFLARE_*, DEFAULT_MODEL) come from groot via sync.
# ──────────────────────────────────────────────────────────────────────

# Path of the pi-durable agent store. Kept separate from DATABASE_URL's
# app.db so Prisma migrations never see pi-durable's tables and the two
# drivers never contend for the same SQLite file. Production defaults to the
# mounted /data volume (same disk as DATABASE_URL's app.db — see the deploy
# docs: one persistent volume at /data, both SQLite files on it). A sidecar
# <path>.lock file is created next to the store.
# @public
AGENT_DB_PATH=if(forEnv(production), "/data/agent.db", if(forEnv(test), "./tmp/agent-test.db", "./data/agent.db"))

# Alternate gateway front door (optional). An exe.dev http-proxy in front of
# gateway.ai.cloudflare.com that injects the Cloudflare token, so no real key
# lives on this machine. Empty = call the gateway host directly.
# @public
GATEWAY_BASE_URL=

# Custom (BYOK) providers configured on the gateway, as a JSON array. Each
# entry: { id, name?, basePath?, models: [{ id, name?, contextWindow?,
# reasoning?, vision? }] }. Models are OpenAI-compatible chat models served
# through /v1/<account>/<gateway>/<id>[/<basePath>]. vision:true declares
# image input (glm-5.3-flash defaults to image-capable; vision:false opts
# out) — without it images are stripped before the wire.
# @public
GATEWAY_CUSTOM_PROVIDERS=

# Optional comma-separated allowlist of model ids (namespaced custom ids
# allowed). When set, /models returns only these and new bots must use one of
# them; empty = the full catalog. Existing bots keep their saved model.
# @public
GATEWAY_MODEL_ALLOWLIST=

# Vision side-call (issue #17): the transcriber model see_image uses for bots
# whose model cannot see images. Empty = the owner's custom glm-5.3-flash
# (any custom provider serving it), then the first vision-capable gateway
# model (workers-ai image models first). A gateway catalog id
# ("workers-ai/@cf/..." or "custom:<provider>/<model>").
# @public
VISION_MODEL=

# Optional direct OpenAI-compatible vision backend (for setups without a
# vision model on the gateway): {base}/chat/completions receives the image.
# When set, it is used when no gateway vision model resolves. Combined with
# VISION_MODEL it names the model on that backend.
# @public
VISION_BASE_URL=

# Bearer key for VISION_BASE_URL (optional).
# @sensitive
VISION_API_KEY=

# Vision side-call timeout in seconds. Default 90.
# @public
VISION_TIMEOUT=

# Alternate front door for the Cloudflare REST API (optional): an http-proxy in
# front of https://api.cloudflare.com/client/v4 that injects the Cloudflare
# token, like GATEWAY_BASE_URL does for inference. Used by the `web` toolkit
# (Web Search API, Browser Rendering). Empty = call api.cloudflare.com with
# CLOUDFLARE_API_KEY (needs Workers AI Read, AI Gateway Read and Browser
# Rendering Write).
# @public
CLOUDFLARE_API_BASE_URL=

# Key that encrypts MCP connection secrets (API keys, OAuth tokens) at rest in
# app.db (AES-256-GCM). Any long random string, e.g. `openssl rand -base64 32`.
# Required before adding a connection with auth; changing it makes stored
# secrets unreadable (reconnect those connections).
# @type=string
# @required=forEnv(test)
# @sensitive
SECRETS_KEY=if(forEnv(test), "test-only-secrets-key-not-for-production")
