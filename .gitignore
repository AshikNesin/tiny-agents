node_modules/

# Compiled output
dist/

# Environment variables
.env
.env.*
!.env.example

/.DS_Store
pnpm-debug.log*

playwright-report/
test-results/
.pnpm-store/

# Verification screenshots (agent-run proof captures, not repo assets)
/.screenshots/


# Local storage (files-sdk fs adapter dev root)
/local/
# SQLite database files (dev/test data). Keep the dir tracked but ignore contents.
/data/*.db
/data/*.db-journal
/data/*.db.lock
/data/*.db.lock-journal
/data/*.db-shm
/data/*.db-wal
# Production volume layout (`file:/data/prod.db`): uploads and backups sit beside it
/data/uploads/
/data/backups/

# Scratch / generated SQL from scripts (e.g. pnpm db:baseline)
/tmp/

# Sensitive files
*.pem
*.key
*.crt
secrets/
credentials.json
service-account.json

# Groot sync generated report
.groot/sync-report.json

settings.local.json
.claude/settings.local.json
.auto/
.audit/
.vitest/
