node_modules/

# Compiled output
dist/

# Environment variables
.env
.env.*
!.env.example

/.DS_Store
pnpm-debug.log*

playwright-report/
test-results/
.pnpm-store/

# Verification screenshots (agent-run proof captures, not repo assets)
/.screenshots/


# Development uploads root (UPLOADS_DIR default outside production: ./local/uploads)
/local/
# Local data (dev/e2e SQLite files and their lock/wal sidecars, agent store,
# browser profiles, production volume uploads and backups). Keep the dir
# tracked but ignore everything inside it.
/data/*
!data/.gitkeep

# Scratch output from scripts
/tmp/

# Sensitive files
*.pem
*.key
*.crt
secrets/
credentials.json
service-account.json

# Amp orb state: portal registrations and agent review artifacts stay local;
# .amp/services.yaml (if added) stays tracked.
.amp/portals/*
.amp/in/

# Groot sync generated report
.groot/sync-report.json

settings.local.json
.auto/
.audit/
.vitest/

# Cloudflare Workers local state (wrangler dev)
.wrangler/

# wrangler dev secrets (copy from .dev.vars.example)
.dev.vars

# Claude Code fork worktrees
.claude/worktrees/

# Local agent taste preferences
.taste/

# Local sandbox mounts (docker/sandbox/compose.override.example.yml)
/docker/sandbox/compose.override.yml
