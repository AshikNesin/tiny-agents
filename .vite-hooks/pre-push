command -v vp >/dev/null || { echo "vp not found: this worktree has no node_modules. Run pnpm install here, then push again."; exit 1; }

# Git passes one line per ref on stdin: <local ref> <local sha> <remote ref>
# <remote sha>. scripts/pre-push.mjs checks the files the pushed commits
# change (format, lint) and runs the incremental typecheck; it skips tag-only
# pushes and deletions.
exec node scripts/pre-push.mjs
