// PostgreSQL schema. Selected when DATABASE_URL is a postgresql:// URL.
// The model definitions are identical to schema.sqlite.prisma; only the
// datasource provider differs (plus native @db.* type hints). Keep the two
// files in sync — a parity test (tests/server/prisma/schema-parity.test.ts)
// asserts the models match.

generator client {
  provider            = "prisma-client"
  output              = "../../../packages/core/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Task {
  id           String    @id @default(cuid())
  title        String // max 300
  description  String    @default("") // notes, max 2000
  status       String    @default("todo") // todo | in_progress | done
  priority     String    @default("medium") // low | medium | high | urgent
  dueAt        DateTime?
  completedAt  DateTime?
  /** Tool-call id that created this task: exactly-once across pi-durable replays. */
  sourceKey    String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, dueAt])
  @@map("tasks")
}

model Bot {
  id                 String    @id @default(cuid())
  name               String
  description        String    @default("")
  systemPrompt       String    @default("")
  modelId            String
  conversationId     String    @unique
  /// When the current chat conversation started (bot create, "New chat"); bots that predate it start at the migration. Routine run cards older than it stay out of the chat.
  chatStartedAt      DateTime  @default(now())
  lastReadAt         DateTime?
  lastActivityAt     DateTime  @default(now())
  lastMessagePreview String?
  /// JSON object: tool name → "allow" | "ask" | "off"; tools without an entry use their default.
  toolPermissions    String    @default("{}")
  skills             BotSkill[]
  connections        BotConnection[]
  /// Messages this bot sent (message_bot tool).
  messagesFrom       BotMessage[] @relation("BotMessagesFrom")
  /// Messages addressed to this bot.
  messagesTo         BotMessage[] @relation("BotMessagesTo")
  /// Conversations whose answer routes back to this bot.
  answersFor         BotMessage[] @relation("BotMessagesReplyTo")
  /// Scheduled routines; each runs in a conversation of its own (issue #63).
  routines           Routine[]
  /// Long-term memories this bot keeps about the owner (issue #22).
  memories           Memory[]
  /// Conversations this bot ran on before a "New chat" (past chats, issue #101).
  pastChats          BotChat[]
  /// Memory capture + injection switch (issue #22).
  memoryEnabled      Boolean   @default(true)
  /// Auto-review switch (issue #65): a classifier may approve "ask" tool calls.
  autoReview         Boolean   @default(false)
  /// Transcript watermark: owner turns captured through this instant (issue #22).
  memoryCapturedThrough DateTime?
  /// Set when the owner pins the bot to the top of the sidebar; pinned bots sort by this, oldest first.
  pinnedAt           DateTime?
  /// Browser profile: "shared" (one browser, and its logins, for every such bot) or "own" (a browser of its own).
  browserProfile     String    @default("shared")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("bots")
}

/// A past chat (issue #101): a conversation this bot ran on before a "New
/// chat". Read-only until the owner continues it, which moves the bot back
/// onto it and drops this row.
model BotChat {
  id                 String   @id @default(cuid())
  botId              String
  /// The retired durable conversation in agent.db.
  conversationId     String   @unique
  /// The bot's chatStartedAt while this was its chat.
  startedAt          DateTime
  /// When "New chat" (or continuing another past chat) retired it.
  endedAt            DateTime
  /// Short title: the first owner message until the title side-call replaces it.
  title              String?
  /// Bot.lastMessagePreview when it was retired.
  lastMessagePreview String?
  messageCount       Int      @default(0)
  bot                Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, endedAt])
  @@map("bot_chats")
}

/// An Agent Skill (SKILL.md) in the shared library (issue #1 D5/D6).
model Skill {
  id          String     @id @default(cuid())
  /// Agent Skills name: lowercase-with-hyphens, unique in the library.
  name        String     @unique
  description String
  /// SKILL.md body (markdown, without frontmatter).
  body        String
  /// JSON array of bundled files: [{ path, content }]. Text only; never executed.
  files       String     @default("[]")
  source      String     @default("manual") // manual | url | bot
  sourceUrl   String?
  bots        BotSkill[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("skills")
}

model BotMessage {
  id           String    @id @default(cuid())
  /// Sender bot id; null when the owner tagged the target in another bot's chat (a mention).
  fromBotId    String?
  /// Receiving bot.
  toBotId      String
  /// Conversation that receives this message's answer (the host of a mention, or the sender). Null = only the owner.
  replyToBotId String?
  /// "send" (message_bot tool) | "mention" (owner @tag) | "relay" (relayed reply).
  kind         String
  /// Idempotency key of the durable submit (requestId of conversation.submit).
  requestId    String    @unique
  /// Durable tool-call id: exactly-once row create across pi-durable replays (same pattern as Task.sourceKey).
  sourceKey    String?   @unique
  text         String
  /// When the message was submitted into the target's durable conversation (pending → delivered).
  deliveredAt  DateTime?
  /// When the target's reply was relayed into replyToBotId's conversation (delivered → answered).
  answeredAt   DateTime?
  /// Created-at of the assistant reply that answered this delivery. Correlates
  /// deliveries to replies so one reply never answers two rows (queued
  /// deliveries) and a reply older than the delivery never answers (stale boot sweep).
  answerReplyAt DateTime?
  createdAt    DateTime  @default(now())

  bot          Bot?       @relation("BotMessagesFrom", fields: [fromBotId], references: [id], onDelete: Cascade)
  to           Bot       @relation("BotMessagesTo", fields: [toBotId], references: [id], onDelete: Cascade)
  replyTo      Bot?      @relation("BotMessagesReplyTo", fields: [replyToBotId], references: [id], onDelete: Cascade)

  @@index([toBotId, answeredAt])
  @@index([replyToBotId, answeredAt])
  @@map("bot_messages")
}

model BotSkill {
  botId     String
  skillId   String
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([botId, skillId])
  @@index([skillId])
  @@map("bot_skills")
}

/// A remote MCP server (issue #1 D8–D13). One account per connection.
model Connection {
  id            String          @id @default(cuid())
  name          String
  /// Capability id suffix (`mcp:<slug>`) and tool name prefix; immutable.
  slug          String          @unique
  url           String
  transport     String          @default("streamable-http") // streamable-http | sse
  authType      String          @default("none") // none | header | oauth
  /// Header carrying `secretEnc` for header auth (e.g. Authorization, x-api-key).
  headerName    String?
  /// AES-GCM (SECRETS_KEY) encrypted header value.
  secretEnc     String?
  /// AES-GCM (SECRETS_KEY) encrypted OAuth state: client registration, tokens, PKCE verifier.
  oauthEnc      String?
  /// JSON array of the server's tools as last listed: [{ name, title, description, readOnly }].
  toolsCache    String          @default("[]")
  /// JSON array of server tool names turned off for every bot; tools the server adds later start on.
  disabledTools String          @default("[]")
  /// Vault handle (`VaultItem.handle`) holding the header value; preferred over `secretEnc` when set.
  secretRef     String?
  bots          BotConnection[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("connections")
}

model BotConnection {
  botId        String
  connectionId String
  bot          Bot        @relation(fields: [botId], references: [id], onDelete: Cascade)
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([botId, connectionId])
  @@index([connectionId])
  @@map("bot_connections")
}

/// A reference to a secret held by a vault backend (issue #56). No secret values live here.
model VaultItem {
  id              String            @id @default(cuid())
  /// Model-facing slug ("github"); the only name bots see.
  handle          String            @unique
  kind            String // login | card | identity | api_key
  backend         String // onepassword-connect | local
  /// Backend item id (Connect item id; the vault is pinned in env).
  externalId      String
  /// api_key: which field holds the key (default: the credential/password field).
  field           String?
  label           String
  /// Login identifier: metadata the bot may type itself.
  username        String?
  /// JSON array of exact origins a login or card fills on.
  originsJson     String            @default("[]")
  /// JSON array of hosts an api_key header may go to.
  hostsJson       String            @default("[]")
  /// JSON {as:"header",name,format} for api_key injection.
  injectJson      String?
  /// JSON array of tools that may use it; [] = the kind's default.
  toolsJson       String            @default("[]")
  /// JSON array of bot ids that may use it; null = every bot.
  botsJson        String?
  approval        String            @default("per_conversation") // every_use | per_conversation | allowed
  allowUnattended Boolean           @default(false)
  whenToUse       String?
  /// JSON {brand,last4,expiry}: display only.
  cardMetaJson    String?
  hasTotp         Boolean           @default(false)
  disabled        Boolean           @default(false)
  lastUsedAt      DateTime?
  lastUsedBy      String?
  events          VaultAuditEvent[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("vault_items")
}

/// Append-only audit of every vault use and Vault UI action. No values, ever.
model VaultAuditEvent {
  id             String     @id @default(cuid())
  at             DateTime   @default(now())
  itemId         String?
  item           VaultItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  /// Kept when the item is deleted.
  handle         String
  botId          String?
  conversationId Int?
  taskId         Int?
  /// Agent tool, "vault_ui" or "credential_request".
  tool           String
  /// Origin, host or redacted command.
  target         String
  /// used | approved_used | denied | expired | refused_* | backend_error | created | updated | deleted | revealed | copied | filled
  outcome        String
  reason         String?
  unattended     Boolean    @default(false)

  @@index([itemId, at])
  @@index([at])
  @@map("vault_audit_events")
}

model Upload {
  id         String   @id @default(cuid())
  /// "image" | "file"
  kind       String
  /// Original filename, sanitized.
  name       String
  mimeType   String
  /// Original byte size.
  size       Int
  /// Images only, after preparation.
  width      Int?
  height     Int?
  /// Storage key of the model-ready image variant (null for files).
  modelKey   String?
  /// Storage key of the original bytes.
  storageKey String   @unique
  createdAt  DateTime @default(now())
  /// SHA-256 of the original bytes (sandbox copies report it).
  sha256        String?
  /// Extraction (issue #58): none | pending | ready | failed | unsupported.
  extractStatus String    @default("none")
  /// Why extraction failed, or why the type can't be read.
  extractError  String?
  /// JSON ExtractMeta: format, pages, sheets, lines, entries, truncated, …
  extractMeta   String?
  extractedAt   DateTime?

  @@map("uploads")
}

/// A standing instruction for a bot: run this prompt on this schedule (issue #18).
model Routine {
  id        String   @id @default(cuid())
  botId     String
  /// Max 80 chars.
  name      String
  /// Max 20k chars.
  prompt    String
  /// JSON schedule union (once | cron | interval), parsed with Zod at every boundary.
  schedule  Json
  /// Paused or terminal (a fired once) routines keep their row but schedule nothing.
  enabled   Boolean  @default(true)
  /// Next occurrence as an absolute UTC instant; null when disabled or terminal.
  nextRunAt DateTime?
  /// The queued routine-fire job for nextRunAt (cancel/reschedule handle).
  pendingJobId String? @unique
  /// Durable tool-call id: exactly-once row create across pi-durable replays (same pattern as Task.sourceKey).
  sourceKey    String?   @unique
  /// The routine's own durable conversation (issue #63): every run is submitted here, never into the bot's chat. Created on first fire; null until then.
  conversationId String? @unique
  /// Runs in a row that ended blocked (issue #87); a run that finishes any other way, or arming the routine again, resets it.
  blockedStreak  Int     @default(0)
  /// Why the app paused the routine itself, e.g. "Paused after 3 blocked runs: <reason>" (issue #87). Max 500 chars; cleared when it is armed again.
  pausedReason   String?
  bot       Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  runs      RoutineRun[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, nextRunAt])
  @@map("routines")
}

/// One durable fact a bot remembers about the owner (issue #22).
model Memory {
  id        String   @id @default(cuid())
  botId     String
  /// One self-contained third-person sentence, max 300 chars.
  text      String
  /// preference | fact | goal | habit (Zod-validated at every boundary).
  category  String
  /// active | superseded | archived | expired | deleted. Only `active` injects.
  status    String   @default("active")
  /// capture | manual (source line on the Memory page).
  source    String   @default("capture")
  /// Extraction confidence 0..1; null for manual entries.
  confidence Float?
  /// Optional expiry; null = no expiry. Expired rows stay rows, leave the prompt.
  until     DateTime?
  /// Set when a newer memory replaced this one (strike-through in the UI).
  supersededById String?
  supersededAt   DateTime?
  bot            Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  supersededBy   Memory?   @relation("MemorySupersession", fields: [supersededById], references: [id])
  superseding    Memory[]  @relation("MemorySupersession")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([botId, status, category])
  @@map("memories")
}

/// One executed occurrence of a routine: the exactly-once ledger.
model RoutineRun {
  id           String   @id @default(cuid())
  routineId    String
  /// The occurrence this run represents (UTC instant).
  scheduledFor DateTime
  /// awaiting | succeeded | blocked | failed | missed | cancelled (blocked: it finished but could not do its job, issue #87)
  status       String
  /// schedule | manual
  trigger      String   @default("schedule")
  /// pi-durable submit id: "routine:<routineId>:<scheduledFor ISO>".
  requestId    String   @unique
  submittedAt  DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  /// Reply preview, max 2000 chars.
  output      String?
  /// Failure or blocked reason, max 500 chars.
  error       String?
  routine      Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@unique([routineId, scheduledFor])
  @@index([status])
  @@map("routine_runs")
}

/// One push notification the app accepted (issue #57): metadata only, never the
/// message body. Backs dedupe across restarts and the Settings log; pruned
/// after 30 days.
model NotificationLog {
  id         String    @id @default(cuid())
  /// "approval.requested", "routine.failed", ...
  event      String
  /// needs_input | notify | security | system
  category   String
  /// "pushover"
  channel    String
  dedupeKey  String
  botId      String?
  /// The rendered (already scrubbed) title.
  title      String
  /// App path only, e.g. /chats/abc.
  url        String?
  priority   Int
  /// queued | sent | failed | suppressed | cancelled
  status     String
  /// throttled | quiet_hours | disabled | duplicate | over_quota | invalid_credentials | invalid_input | transient
  reason     String?
  /// Pushover `request` id.
  providerId String?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  sentAt     DateTime?

  @@index([dedupeKey, createdAt])
  @@index([createdAt])
  @@map("notification_log")
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  name      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  passkeys  Passkey[]

  @@map("users")
}

model Passkey {
  id             Int       @id @default(autoincrement())
  userId         Int
  credentialId   String    @unique
  publicKey      Bytes
  counter        BigInt    @default(0)
  deviceType     String?
  backedUp       Boolean   @default(false)
  transports     Json
  credentialName String?
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

// The keyv table is managed by @keyv/postgres / @keyv/sqlite at runtime, so
// Prisma must not create or migrate it. @@ignore keeps it out of migrations.
model Keyv {
  key   String @id
  value String

  @@map("keyv")
  @@ignore
}

// Job execution logs for real-time monitoring.
model JobLog {
  id        Int      @id @default(autoincrement())
  jobId     String
  jobName   String?
  level     String
  message   String
  data      Json?
  timestamp DateTime @default(now())

  @@index([jobId])
  @@index([timestamp])
  @@map("job_logs")
}
