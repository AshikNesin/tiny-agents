// PostgreSQL schema. Selected when DATABASE_URL is a postgresql:// URL.
// The model definitions are identical to schema.sqlite.prisma; only the
// datasource provider differs (plus native @db.* type hints). Keep the two
// files in sync — a parity test (tests/server/prisma/schema-parity.test.ts)
// asserts the models match.

generator client {
  provider            = "prisma-client"
  output              = "../../../packages/core/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Task {
  id           String    @id @default(cuid())
  title        String // max 300
  description  String    @default("") // notes, max 2000
  status       String    @default("todo") // todo | in_progress | done
  priority     String    @default("medium") // low | medium | high | urgent
  dueAt        DateTime?
  completedAt  DateTime?
  /** Tool-call id that created this task: exactly-once across pi-durable replays. */
  sourceKey    String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, dueAt])
  @@map("tasks")
}

model Bot {
  id                 String    @id @default(cuid())
  name               String
  description        String    @default("")
  systemPrompt       String    @default("")
  modelId            String
  avatarEmoji        String?
  avatarColor        String
  conversationId     String    @unique
  lastReadAt         DateTime?
  lastActivityAt     DateTime  @default(now())
  lastMessagePreview String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("bots")
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  name      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  passkeys  Passkey[]

  @@map("users")
}

model Passkey {
  id             Int       @id @default(autoincrement())
  userId         Int
  credentialId   String    @unique
  publicKey      Bytes
  counter        BigInt    @default(0)
  deviceType     String?
  backedUp       Boolean   @default(false)
  transports     Json
  credentialName String?
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

// The keyv table is managed by @keyv/postgres / @keyv/sqlite at runtime, so
// Prisma must not create or migrate it. @@ignore keeps it out of migrations.
model Keyv {
  key   String @id
  value String

  @@map("keyv")
  @@ignore
}

// Job execution logs for real-time monitoring.
model JobLog {
  id        Int      @id @default(autoincrement())
  jobId     String
  jobName   String?
  level     String
  message   String
  data      Json?
  timestamp DateTime @default(now())

  @@index([jobId])
  @@index([timestamp])
  @@map("job_logs")
}
