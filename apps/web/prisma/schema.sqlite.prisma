// SQLite schema. Selected when DATABASE_URL is a file: path or bare path (default).
// The model definitions are identical to schema.postgres.prisma; only the
// datasource provider differs. Keep the two files in sync — a parity test
// (tests/server/prisma/schema-parity.test.ts) asserts the models match.

generator client {
  provider            = "prisma-client"
  output              = "../../../packages/core/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

model Task {
  id           String    @id @default(cuid())
  title        String // max 300
  description  String    @default("") // notes, max 2000
  status       String    @default("todo") // todo | in_progress | done
  priority     String    @default("medium") // low | medium | high | urgent
  dueAt        DateTime?
  completedAt  DateTime?
  /** Tool-call id that created this task: exactly-once across pi-durable replays. */
  sourceKey    String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, dueAt])
  @@map("tasks")
}

model Bot {
  id                 String    @id @default(cuid())
  name               String
  description        String    @default("")
  systemPrompt       String    @default("")
  modelId            String
  conversationId     String    @unique
  lastReadAt         DateTime?
  lastActivityAt     DateTime  @default(now())
  lastMessagePreview String?
  /// JSON array of enabled built-in toolkit ids, e.g. ["tasks", "web"] (issue #1 D2).
  toolkits           String    @default("[]")
  /// JSON object: tool name → "allow" | "ask" | "off"; tools without an entry use their default.
  toolPermissions    String    @default("{}")
  skills             BotSkill[]
  connections        BotConnection[]
  /// Messages this bot sent (message_bot tool).
  messagesFrom       BotMessage[] @relation("BotMessagesFrom")
  /// Messages addressed to this bot.
  messagesTo         BotMessage[] @relation("BotMessagesTo")
  /// Conversations whose answer routes back to this bot.
  answersFor         BotMessage[] @relation("BotMessagesReplyTo")
  /// Scheduled routines that run prompts in this bot's conversation.
  routines           Routine[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("bots")
}

/// An Agent Skill (SKILL.md) in the shared library (issue #1 D5/D6).
model Skill {
  id          String     @id @default(cuid())
  /// Agent Skills name: lowercase-with-hyphens, unique in the library.
  name        String     @unique
  description String
  /// SKILL.md body (markdown, without frontmatter).
  body        String
  /// JSON array of bundled files: [{ path, content }]. Text only; never executed.
  files       String     @default("[]")
  source      String     @default("manual") // manual | url | bot
  sourceUrl   String?
  bots        BotSkill[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("skills")
}

model BotMessage {
  id           String    @id @default(cuid())
  /// Sender bot id; null when the owner tagged the target in another bot's chat (a mention).
  fromBotId    String?
  /// Receiving bot.
  toBotId      String
  /// Conversation that receives this message's answer (the host of a mention, or the sender). Null = only the owner.
  replyToBotId String?
  /// "send" (message_bot tool) | "mention" (owner @tag) | "relay" (relayed reply).
  kind         String
  /// Idempotency key of the durable submit (requestId of conversation.submit).
  requestId    String    @unique
  /// Durable tool-call id: exactly-once row create across pi-durable replays (same pattern as Task.sourceKey).
  sourceKey    String?   @unique
  text         String
  /// When the message was submitted into the target's durable conversation (pending → delivered).
  deliveredAt  DateTime?
  /// When the target's reply was relayed into replyToBotId's conversation (delivered → answered).
  answeredAt   DateTime?
  /// Created-at of the assistant reply that answered this delivery. Correlates
  /// deliveries to replies so one reply never answers two rows (queued
  /// deliveries) and a reply older than the delivery never answers (stale boot sweep).
  answerReplyAt DateTime?
  createdAt    DateTime  @default(now())

  bot          Bot?       @relation("BotMessagesFrom", fields: [fromBotId], references: [id], onDelete: Cascade)
  to           Bot       @relation("BotMessagesTo", fields: [toBotId], references: [id], onDelete: Cascade)
  replyTo      Bot?      @relation("BotMessagesReplyTo", fields: [replyToBotId], references: [id], onDelete: Cascade)

  @@index([toBotId, answeredAt])
  @@index([replyToBotId, answeredAt])
  @@map("bot_messages")
}

model BotSkill {
  botId     String
  skillId   String
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([botId, skillId])
  @@index([skillId])
  @@map("bot_skills")
}

/// A remote MCP server (issue #1 D8–D13). One account per connection.
model Connection {
  id         String          @id @default(cuid())
  name       String
  /// Capability id suffix (`mcp:<slug>`) and tool name prefix; immutable.
  slug       String          @unique
  url        String
  transport  String          @default("streamable-http") // streamable-http | sse
  authType   String          @default("none") // none | header | oauth
  /// Header carrying `secretEnc` for header auth (e.g. Authorization, x-api-key).
  headerName String?
  /// AES-GCM (SECRETS_KEY) encrypted header value.
  secretEnc  String?
  /// AES-GCM (SECRETS_KEY) encrypted OAuth state: client registration, tokens, PKCE verifier.
  oauthEnc   String?
  /// JSON array of the server's tools as last listed: [{ name, title, description, readOnly }].
  toolsCache String          @default("[]")
  bots       BotConnection[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@map("connections")
}

model BotConnection {
  botId        String
  connectionId String
  bot          Bot        @relation(fields: [botId], references: [id], onDelete: Cascade)
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([botId, connectionId])
  @@index([connectionId])
  @@map("bot_connections")
}

model Upload {
  id         String   @id @default(cuid())
  /// "image" | "file"
  kind       String
  /// Original filename, sanitized.
  name       String
  mimeType   String
  /// Original byte size.
  size       Int
  /// Images only, after preparation.
  width      Int?
  height     Int?
  /// Storage key of the model-ready image variant (null for files).
  modelKey   String?
  /// Storage key of the original bytes.
  storageKey String   @unique
  createdAt  DateTime @default(now())

  @@map("uploads")
}

/// A standing instruction for a bot: run this prompt on this schedule (issue #18).
model Routine {
  id        String   @id @default(cuid())
  botId     String
  /// Max 80 chars.
  name      String
  /// Max 20k chars.
  prompt    String
  /// JSON schedule union (once | cron | interval), parsed with Zod at every boundary.
  schedule  Json
  /// Paused or terminal (a fired once) routines keep their row but schedule nothing.
  enabled   Boolean  @default(true)
  /// Next occurrence as an absolute UTC instant; null when disabled or terminal.
  nextRunAt DateTime?
  /// The queued routine-fire job for nextRunAt (cancel/reschedule handle).
  pendingJobId String? @unique
  /// Durable tool-call id: exactly-once row create across pi-durable replays (same pattern as Task.sourceKey).
  sourceKey    String?   @unique
  bot       Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  runs      RoutineRun[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, nextRunAt])
  @@map("routines")
}

/// One executed occurrence of a routine: the exactly-once ledger.
model RoutineRun {
  id           String   @id @default(cuid())
  routineId    String
  /// The occurrence this run represents (UTC instant).
  scheduledFor DateTime
  /// awaiting | succeeded | failed | missed | cancelled
  status       String
  /// schedule | manual
  trigger      String   @default("schedule")
  /// pi-durable submit id: "routine:<routineId>:<scheduledFor ISO>".
  requestId    String   @unique
  submittedAt  DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  /// Reply preview, max 2000 chars.
  output      String?
  /// Failure reason, max 500 chars.
  error       String?
  routine      Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@unique([routineId, scheduledFor])
  @@index([status])
  @@map("routine_runs")
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  name      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  passkeys  Passkey[]

  @@map("users")
}

model Passkey {
  id             Int       @id @default(autoincrement())
  userId         Int
  credentialId   String    @unique
  publicKey      Bytes
  counter        BigInt    @default(0)
  deviceType     String?
  backedUp       Boolean   @default(false)
  transports     Json
  credentialName String?
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

// The keyv table is managed by @keyv/postgres / @keyv/sqlite at runtime, so
// Prisma must not create or migrate it. @@ignore keeps it out of migrations.
model Keyv {
  key   String @id
  value String

  @@map("keyv")
  @@ignore
}

// Job execution logs for real-time monitoring.
// NOTE: pg-boss (the job queue) is Postgres-only. On a SQLite DATABASE_URL
// the job queue is disabled, so JobLog rows are never written; the table is
// kept in the schema so the generated client compiles and existing code that
// references `prisma.jobLog` stays valid on both engines.
model JobLog {
  id        Int      @id @default(autoincrement())
  jobId     String
  jobName   String?
  level     String
  message   String
  data      Json?
  timestamp DateTime @default(now())

  @@index([jobId])
  @@index([timestamp])
  @@map("job_logs")
}

// Honker job-queue tables. honker (@russellthehippo/honker-node, the SQLite
// queue) creates these at runtime via CREATE TABLE ... IF NOT EXISTS. They are
// mirrored here so Prisma's migration history stays in sync with the runtime
// schema — otherwise `prisma migrate dev` reports drift against tables it never
// created and tries to drop them. @@ignore keeps Prisma from generating DDL for
// these models; the canonical table/index definitions live in migration
// 20260316000000_honker_tables. The 3 partial (WHERE-predicate) indexes honker
// uses on _honker_live can't be expressed in Prisma syntax, so they exist only
// in the migration SQL (the @@index directives here omit them on purpose).
// honker is SQLite-only, so these models have no postgres counterpart.
model HonkerLive {
  id             Int      @id @default(autoincrement())
  queue          String
  payload        String
  state          String   @default("pending")
  priority       Int      @default(0)
  runAt          Int      @default(dbgenerated("unixepoch()")) @map("run_at")
  workerId       String?  @map("worker_id")
  claimExpiresAt Int?     @map("claim_expires_at")
  attempts       Int      @default(0)
  maxAttempts    Int      @default(3) @map("max_attempts")
  createdAt      Int      @default(dbgenerated("unixepoch()")) @map("created_at")
  expiresAt      Int?     @map("expires_at")

  @@map("_honker_live")
  @@ignore
}

model HonkerDead {
  id          Int     @id
  queue       String
  payload     String
  priority    Int     @default(0)
  runAt       Int     @default(0) @map("run_at")
  attempts    Int     @default(0)
  maxAttempts Int     @default(0) @map("max_attempts")
  lastError   String? @map("last_error")
  createdAt   Int     @default(dbgenerated("unixepoch()")) @map("created_at")
  diedAt      Int     @default(dbgenerated("unixepoch()")) @map("died_at")

  @@map("_honker_dead")
  @@ignore
}

model HonkerNotification {
  id        Int    @id @default(autoincrement())
  channel   String
  payload   String
  createdAt Int    @default(dbgenerated("unixepoch()")) @map("created_at")

  @@index([channel, id], map: "_honker_notifications_recent")
  @@map("_honker_notifications")
  @@ignore
}

model HonkerLock {
  name      String @id
  owner     String
  expiresAt Int    @map("expires_at")

  @@map("_honker_locks")
  @@ignore
}

model HonkerRateLimit {
  name        String
  windowStart Int @map("window_start")
  count       Int @default(0)

  @@id([name, windowStart])
  @@map("_honker_rate_limits")
  @@ignore
}

model HonkerSchedulerTask {
  name        String  @id
  queue       String
  cronExpr    String  @map("cron_expr")
  payload     String
  priority    Int     @default(0)
  expiresS    Int?    @map("expires_s")
  nextFireAt  Int     @map("next_fire_at")
  enabled     Int     @default(1)
  maxAttempts Int     @default(3) @map("max_attempts")

  @@map("_honker_scheduler_tasks")
  @@ignore
}

model HonkerResult {
  jobId     Int     @id @map("job_id")
  value     String?
  createdAt Int     @default(dbgenerated("unixepoch()")) @map("created_at")
  expiresAt Int?    @map("expires_at")

  @@map("_honker_results")
  @@ignore
}

model HonkerStream {
  offset    Int    @id @default(autoincrement())
  topic     String
  key       String?
  payload   String
  createdAt Int    @default(dbgenerated("unixepoch()")) @map("created_at")

  @@index([topic, offset], map: "_honker_stream_topic")
  @@map("_honker_stream")
  @@ignore
}

model HonkerStreamConsumer {
  name   String
  topic  String
  offset Int    @default(0)

  @@id([name, topic])
  @@map("_honker_stream_consumers")
  @@ignore
}
