# Worker VM only. Never copy this file to the tiny-agents host.
# Create the token with: openssl rand -base64 32
# chmod 600 this file. Do not commit a real token.

# Required. 32 bytes, base64. Checked on the WebSocket upgrade.
CLAUDE_WORKER_TOKEN=

# Loopback port. tailscale serve publishes it. Do not change the bind address.
CLAUDE_WORKER_PORT=8765

# Optional. Only if `claude setup-token` told you Claude Code needs it on
# this VM. tiny-agents does not read this value for itself.
# CLAUDE_CODE_OAUTH_TOKEN=

# Leave these UNSET. The worker refuses to start when any of them is set.
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=
# CLAUDE_CODE_USE_BEDROCK=
# CLAUDE_CODE_USE_VERTEX=
# CLAUDE_CODE_USE_FOUNDRY=

# Optional timings (defaults shown).
# CLAUDE_WORKER_PING_MS=20000
# CLAUDE_WORKER_SILENCE_MS=60000
# CLAUDE_WORKER_TOOL_TIMEOUT_MS=120000
# CLAUDE_WORKER_IDLE_MS=900000
# CLAUDE_WORKER_MAX_AGE_MS=21600000
# CLAUDE_WORKER_MAX_PROCESSES=2
# CLAUDE_WORKER_MAX_TURNS=1
# CLAUDE_WORKER_EVENT_BUFFER=1000
# CLAUDE_WORKER_QUERY_MAX_TURNS=30
