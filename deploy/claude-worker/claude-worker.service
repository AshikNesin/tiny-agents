[Unit]
Description=tiny-agents Claude Code worker
After=default.target

[Service]
Type=simple
# Ordinary user. The Claude login lives in this user's home, not in tiny-agents.
WorkingDirectory=%h/tiny-agents
ExecStart=/usr/bin/node --experimental-strip-types %h/tiny-agents/packages/claude-worker/src/bin.ts
EnvironmentFile=%h/.config/tiny-agents/claude-worker.env
Restart=always
RestartSec=2
NoNewPrivileges=true

[Install]
WantedBy=default.target
