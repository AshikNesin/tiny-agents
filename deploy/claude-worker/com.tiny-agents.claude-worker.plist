<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tiny-agents.claude-worker</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- GUI session of the user who ran `claude auth login`. Not a root LaunchDaemon. -->
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>WorkingDirectory</key>
  <string>/Users/USER/tiny-agents</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>--experimental-strip-types</string>
    <string>/Users/USER/tiny-agents/packages/claude-worker/src/bin.ts</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CLAUDE_WORKER_TOKEN</key>
    <string>REPLACE_WITH_openssl_rand_base64_32</string>
    <key>CLAUDE_WORKER_PORT</key>
    <string>8765</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>/Users/USER</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/USER/Library/Logs/claude-worker.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/USER/Library/Logs/claude-worker.err.log</string>
</dict>
</plist>
