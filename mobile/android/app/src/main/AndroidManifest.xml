<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: the server's notifications (issue #306), asked for after sign-in. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".GrootMobileApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.GrootMobile">
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The server's links (a push notification's) open here. Verified when the server
                 serves /.well-known/assetlinks.json (ANDROID_APP_CERT_SHA256); the host is
                 `linkHost` in app/build.gradle.kts. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="${linkHost}" />
                <data android:pathPrefix="/chats/" />
                <data android:pathPrefix="/vault" />
                <data android:path="/routines" />
                <data android:path="/tasks" />
            </intent-filter>
            <!-- The bots data/ShareTargets.kt publishes as Direct Share targets. -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>
        <!-- Share from another app: a sheet over it to pick a bot, add a note and send. It runs in
             the sharing app's task, so closing it goes straight back there. -->
        <activity
            android:name=".ShareActivity"
            android:label="@string/app_name"
            android:theme="@style/Theme.GrootMobile.Share"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <!-- Phone notifications (issue #306): the UnifiedPush distributor delivers here. -->
        <service
            android:name=".push.TinyAgentsPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
        <!-- A notification's Approve, Deny and third button: Android 12+ runs it once unlocked. -->
        <receiver
            android:name=".push.NotificationActionReceiver"
            android:exported="false" />
        <!-- The same buttons on Android 10 and 11: asks for the unlock, answers, closes. -->
        <activity
            android:name=".push.UnlockToAnswerActivity"
            android:theme="@style/Theme.GrootMobile.Share"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:exported="false" />
    </application>

</manifest>
