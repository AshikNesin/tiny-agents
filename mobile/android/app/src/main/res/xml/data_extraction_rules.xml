<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup rules: back up and transfer nothing, matching allowBackup="false".
    The auth token is sealed with an Android Keystore key that never leaves the device, so a
    restored copy could not be decrypted anyway.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
