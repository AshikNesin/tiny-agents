{
  "name": "tiny-agents",
  "version": "0.1.0",
  "description": "Personal always-on AI bots on pi-durable",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/bundle.js",
  "scripts": {
    "dev": "NODE_ENV=development PORTLESS_PORT=8888 portless run --name $npm_package_name varlock run -- tsx scripts/dev.ts",
    "dev:debug": "NODE_ENV=development PORTLESS_PORT=8888 portless run --name $npm_package_name varlock run -- node --inspect --import ./node_modules/tsx/dist/loader.mjs apps/web/src/server/index.ts",
    "build": "varlock run -- sh -c 'rm -rf dist && prisma generate && vp build && node scripts/build.mjs'",
    "start": "NODE_ENV=production varlock run -- node dist/bundle.js",
    "lint": "vp lint",
    "format": "vp fmt",
    "check": "vp check",
    "check:tokens": "tsx scripts/check-design-tokens.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web",
    "typecheck:client": "tsc --noEmit -p apps/web",
    "typecheck:kit": "tsc --noEmit -p tests/kit-consumers",
    "check:closure": "node scripts/check-runtime-closure.mjs",
    "check:coverage": "tsx scripts/check-checks-coverage.ts",
    "pretest": "NODE_ENV=test tsx scripts/ensure-test-db.ts",
    "test": "NODE_ENV=test varlock run -- vp test run --config vitest.config.server.ts",
    "test:client": "vp test run",
    "check:schema": "node scripts/check-runtime-schema.mjs",
    "check:schema:postgres": "node scripts/check-runtime-schema-postgres.mjs",
    "test:all": "pnpm test && pnpm test:client",
    "pretest:watch": "NODE_ENV=test tsx scripts/ensure-test-db.ts",
    "test:watch": "NODE_ENV=test varlock run -- vp test --config vitest.config.server.ts",
    "test:e2e": "PORTLESS=0 varlock run -- playwright test",
    "test:e2e:ui": "varlock run -- playwright test --ui",
    "test:db:start": "tsx scripts/ensure-test-db.ts",
    "test:db:reset": "NODE_ENV=test tsx scripts/ensure-test-db.ts --reset",
    "prisma:generate": "varlock run -- prisma generate",
    "generate": "varlock run -- prisma generate",
    "db:migrate": "varlock run -- prisma migrate deploy",
    "db:migrate:create": "varlock run -- prisma migrate dev --create-only",
    "db:migrate:reset": "varlock run -- prisma migrate reset",
    "db:baseline": "varlock run -- node scripts/db-sync-baseline.cjs",
    "db:seed": "varlock run -- prisma db seed",
    "prestart": "varlock run -- prisma migrate deploy",
    "postinstall": "node scripts/varlock.js -- prisma generate",
    "prepare": "vp config || [ ! -x node_modules/.bin/vp ]",
    "groot:setup": "bash .groot/setup-boilerplate.sh",
    "groot:check": "tsx .groot/sync.ts check",
    "groot:sync": "tsx .groot/sync.ts apply",
    "groot:resolve": "tsx .groot/resolve.ts",
    "groot:upstream": "tsx .groot/upstream.ts",
    "changeset": "changeset",
    "check:changesets": "node scripts/check-changesets.mjs",
    "changeset:version": "changeset version",
    "changeset:status": "changeset status",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-presigned-post": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^6.0.0",
    "@keyv/postgres": "^2.2.3",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@russellthehippo/honker-node": "^0.5.1",
    "@sentry/node": "^11.9.0",
    "@sentry/profiling-node": "^11.9.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@tanstack/react-query": "^5.104.5",
    "@uiw/react-codemirror": "^4.25.12",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "close-with-grace": "^2.5.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "compression": "^1.8.2",
    "console-feed": "^3.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "files-sdk": "^3.1.2",
    "js-yaml": "^5.5.0",
    "jsonwebtoken": "^9.0.3",
    "keyv": "^5.6.0",
    "lodash.mergewith": "^4.6.2",
    "lucide-react": "^1.61.0",
    "ms": "2.1.3",
    "multer": "^2.5.0",
    "nuqs": "^2.10.2",
    "openai": "^7.43.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "playwright-core": "1.64.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.4",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "sqlite3": "^6.0.1",
    "ssh2": "1.17.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "varlock": "^1.23.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.1",
    "@sentry/esbuild-plugin": "^11.9.0",
    "@sentry/vite-plugin": "^11.9.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash.merge": "^4.6.9",
    "@types/lodash.mergewith": "^4.6.9",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "baseline-browser-mapping": "^2.11.32",
    "esbuild": "^0.28.2",
    "esbuild-plugin-alias": "^0.2.1",
    "jsdom": "^30.1.3",
    "micromatch": "^4.0.8",
    "postcss": "^8.5.31",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.32.1"
}
