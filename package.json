{
  "name": "tiny-agents",
  "version": "0.1.1",
  "description": "Personal always-on AI bots on pi-durable",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/server/bundle.js",
  "scripts": {
    "dev": "NODE_ENV=development PORTLESS_PORT=8888 portless run --name $npm_package_name tsx scripts/dev.ts",
    "build": "rm -rf dist && vp build && node scripts/build.mjs",
    "start": "NODE_ENV=production node dist/server/bundle.js",
    "lint": "vp lint",
    "format": "vp fmt",
    "check": "vp check",
    "check:tokens": "tsx scripts/check-design-tokens.ts",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/server.tsbuildinfo && tsc --noEmit -p apps/web --incremental --tsBuildInfoFile node_modules/.cache/tsc/client.tsbuildinfo && tsc --noEmit -p tests/e2e --incremental --tsBuildInfoFile node_modules/.cache/tsc/e2e.tsbuildinfo",
    "typecheck:client": "tsc --noEmit -p apps/web",
    "typecheck:e2e": "tsc --noEmit -p tests/e2e",
    "typecheck:kit": "tsc --noEmit -p tests/kit-consumers",
    "check:closure": "node scripts/check-runtime-closure.mjs",
    "check:coverage": "tsx scripts/check-checks-coverage.ts",
    "check:dead": "knip --no-progress || { echo 'Dead code. If a flagged file is loaded by URL, dynamic import or a script, add it to `entry` in knip.json. Otherwise delete it: `pnpm exec tsx scripts/codemods/remove-dead-code.ts` (add --remove-files to delete unused files).'; exit 1; }",
    "test": "NODE_ENV=test vp test run --config vitest.config.server.ts",
    "test:client": "vp test run",
    "test:all": "pnpm test && pnpm test:client",
    "verify": "pnpm verify:static && pnpm test && pnpm test:client",
    "verify:static": "node scripts/gates.mjs",
    "test:watch": "NODE_ENV=test vp test --config vitest.config.server.ts",
    "test:e2e": "PORTLESS=0 playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "sandbox:up": "tsx scripts/sandbox.ts up",
    "sandbox:down": "tsx scripts/sandbox.ts down",
    "sandbox:logs": "tsx scripts/sandbox.ts logs",
    "sandbox:shell": "tsx scripts/sandbox.ts shell",
    "sandbox:reset": "tsx scripts/sandbox.ts reset",
    "prepare": "node scripts/relative-hooks-path.mjs; vp config || [ ! -x node_modules/.bin/vp ]",
    "groot:setup": "bash .groot/setup-boilerplate.sh",
    "groot:check": "tsx .groot/sync.ts check",
    "groot:sync": "tsx .groot/sync.ts apply",
    "groot:resolve": "tsx .groot/resolve.ts",
    "groot:upstream": "tsx .groot/upstream.ts",
    "changeset": "changeset",
    "check:changesets": "node scripts/check-changesets.mjs",
    "check:doc-refs": "node scripts/check-doc-refs.mjs",
    "check:migrations-immutable": "node scripts/check-migrations-immutable.mjs",
    "changeset:version": "changeset version",
    "changeset:status": "changeset status",
    "doctor": "pnpm dlx react-doctor@latest",
    "build:client": "vp build",
    "site:build": "vp build --config site/demos/vite.config.ts",
    "db:generate": "node scripts/db-generate.mjs",
    "db:studio": "drizzle-kit studio",
    "dev:debug": "NODE_ENV=development PORTLESS_PORT=8888 portless run --name $npm_package_name node --inspect --import ./node_modules/tsx/dist/loader.mjs apps/web/src/server/entry.node.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/node-server": "^1.19.0",
    "@hookform/resolvers": "^6.0.0",
    "@sentry/node": "^11.9.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@tanstack/react-query": "^5.104.5",
    "@uiw/react-codemirror": "^4.25.12",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "console-feed": "^3.8.0",
    "croner": "^10.0.0",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "hono": "^4.10.0",
    "jose": "^6.1.0",
    "js-yaml": "^5.5.0",
    "lucide-react": "^1.61.0",
    "ms": "2.1.3",
    "nuqs": "^2.10.2",
    "openai": "^7.43.0",
    "playwright-core": "1.64.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.4",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "ssh2": "1.17.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.9.1",
    "ws": "8.22.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.1",
    "@sentry/esbuild-plugin": "^11.9.0",
    "@sentry/vite-plugin": "^11.9.0",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/micromatch": "4.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "baseline-browser-mapping": "^2.11.32",
    "drizzle-kit": "^0.31.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "micromatch": "^4.0.8",
    "motion": "^14.9.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.32.1"
}
