{
  "name": "@tiny-agents/agent",
  "version": "0.5.0",
  "private": true,
  "description": "tiny-agents' only boundary to pi-durable (the root: durable bot conversations, chat streams, activity, toolkits), plus subpaths for the sandbox connection, terminal, browser, computer and Claude worker, which do not use it.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./sandbox": "./src/subpaths/sandbox.ts",
    "./terminal": "./src/subpaths/terminal.ts",
    "./browser": "./src/subpaths/browser.ts",
    "./computer": "./src/subpaths/computer.ts",
    "./claude-worker": "./src/subpaths/claude-worker.ts",
    "./testing": "./src/testing.ts",
    "./peer-envelope": "./src/toolkits/peer-envelope.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tiny-agents/claude-worker": "workspace:*",
    "playwright-core": "1.64.1",
    "ssh2": "1.17.0",
    "ws": "8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ssh2": "1.15.6",
    "@types/ws": "8.18.2"
  }
}
