{
  "name": "@tiny-agents/agent",
  "version": "1.2.0",
  "private": true,
  "description": "tiny-agents' only boundary to pi-durable (the root: durable bot conversations, chat streams, activity, toolkits), plus a subpath for the Claude worker, which does not use it. The sandbox subpaths re-export @tiny-agents/sandbox, deprecated.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./sandbox": "./src/subpaths/sandbox.ts",
    "./terminal": "./src/subpaths/terminal.ts",
    "./browser": "./src/subpaths/browser.ts",
    "./computer": "./src/subpaths/computer.ts",
    "./claude-worker": "./src/subpaths/claude-worker.ts",
    "./testing": "./src/testing.ts",
    "./peer-envelope": "./src/toolkits/peer-envelope.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tiny-agents/claude-worker": "workspace:*",
    "@tiny-agents/models": "workspace:*",
    "@tiny-agents/sandbox": "workspace:*",
    "undici": "8.12.3",
    "ws": "8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "8.18.2"
  }
}
