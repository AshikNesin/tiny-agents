exports[`ChatMessageView, pinned > a failed tool row opens to a destructive output > markup 1`] = `
"<div>
  <div
    class="group/message relative flex w-full min-w-0 gap-2 text-sm data-[align=end]:flex-row-reverse group"
    data-align="start"
    data-slot="message"
  >
    <div
      class="min-w-0 flex-1"
    >
      <div
        class="mb-2 space-y-1"
      >
        <div
          class="flex w-full min-w-0 flex-col *:has-[>[data-slot=trace-line]]:flex *:has-[>[data-slot=trace-line]]:w-fit *:has-[>[data-slot=trace-line]]:max-w-full *:has-[>[data-slot=trace-line]]:min-w-0 *:has-[>[data-slot=trace-line]]:rounded-md *:has-[>[data-slot=trace-line]]:text-left *:has-[>[data-slot=trace-line]]:outline-none *:has-[>[data-slot=trace-line]]:focus-visible:ring-3 *:has-[>[data-slot=trace-line]]:focus-visible:ring-ring/50 gap-1"
          data-slot="trace"
        >
          <div
            class="flex w-full min-w-0 flex-col"
            data-slot="trace-collapsible"
            data-state="open"
          >
            <button
              aria-controls="radix-<id1>"
              aria-expanded="true"
              class="group/trace-collapsible-trigger flex w-fit max-w-full min-w-0 cursor-pointer items-center gap-1 rounded-md text-left text-muted-foreground outline-none hover:text-foreground focus-visible:ring-3 focus-visible:ring-ring/50 has-[[data-status=error]]:text-destructive"
              data-slot="trace-collapsible-trigger"
              data-state="open"
              type="button"
            >
              <span
                class="flex w-fit max-w-full min-w-0 items-center gap-2 text-sm text-muted-foreground in-[a,button]:cursor-pointer in-[a:hover,button:hover]:text-foreground data-[status=error]:text-destructive data-[status=error]:in-[a:hover,button:hover]:text-destructive data-[status=pending]:opacity-60 data-[status=running]:*:data-[slot=trace-title]:shimmer"
                data-slot="trace-line"
                data-status="error"
              >
                <span
                  class="min-w-0 truncate motion-reduce:shimmer-none"
                  data-slot="trace-title"
                >
                  Opened a page
                </span>
              </span>
              <span
                aria-hidden="true"
                class="flex size-4 shrink-0 items-center justify-center [&_svg]:pointer-events-none [&_svg:not([class*='size-'])]:size-4 [[data-slot=trace-title]~&]:-ml-1 transition-transform group-aria-expanded/trace-collapsible-trigger:rotate-90"
                data-slot="trace-icon"
              >
                <svg
                  aria-hidden="true"
                  class="lucide lucide-chevron-right"
                  fill="none"
                  height="24"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  width="24"
                  xmlns="http://www.w3.org/2000/svg"
                />
              </span>
            </button>
            <div
              class="min-w-0 overflow-hidden duration-200 [--radix-accordion-content-height:var(--radix-collapsible-content-height)] data-open:animate-accordion-down data-closed:animate-accordion-up"
              data-slot="trace-collapsible-content"
              data-state="open"
              id="radix-<id1>"
              style=""
            >
              <div
                class="mt-2 mb-1 ml-[calc(--spacing(2)-1px)] min-w-0 border-l pr-1 pl-4 leading-relaxed wrap-break-word text-muted-foreground space-y-2"
                data-slot="trace-collapsible-content-inner"
              >
                <div>
                  <div
                    class="flex flex-col gap-2"
                  >
                    <div
                      class="group/code-block relative flex w-full min-w-0 flex-col overflow-hidden rounded-lg text-sm has-[>[data-slot=code-block-content]:focus-visible]:ring-3 has-[>[data-slot=code-block-content]:focus-visible]:ring-ring/50 data-[size=sm]:text-xs border border-destructive/30 text-destructive dark:border-destructive/40"
                      data-size="sm"
                      data-slot="code-block"
                      data-variant="destructive"
                    >
                      <div
                        class="flex min-w-0 shrink-0 items-center gap-2 px-3 pt-3 text-muted-foreground group-data-[size=sm]/code-block:px-2.5 group-data-[size=sm]/code-block:pt-2.5 group-data-[variant=destructive]/code-block:text-destructive *:has-[>[data-slot=code-block-title]]:min-w-0"
                        data-slot="code-block-header"
                      >
                        <div
                          class="min-w-0 truncate font-sans text-sm font-medium text-foreground group-data-[size=sm]/code-block:text-xs group-data-[variant=destructive]/code-block:text-destructive [&_svg]:pointer-events-none [&_svg]:inline-block [&_svg]:align-middle [&_svg:not([class*='size-'])]:size-3.5 *:[svg]:me-1.5"
                          data-slot="code-block-title"
                        >
                          Output
                        </div>
                      </div>
                      <pre
                        class="min-h-0 min-w-0 scroll-fade-x overflow-auto px-3 py-3 text-start font-mono leading-relaxed outline-none group-has-data-[slot=code-block-footer]/code-block:pb-2 group-has-data-[slot=code-block-header]/code-block:pt-2 group-data-[size=sm]/code-block:px-2.5 group-data-[size=sm]/code-block:py-2.5 group-data-[size=sm]/code-block:group-has-data-[slot=code-block-header]/code-block:pt-1.5 data-wrap:scroll-fade-y data-wrap:wrap-break-word data-wrap:whitespace-pre-wrap max-h-64 overflow-y-auto overscroll-contain [scrollbar-width:auto] [scrollbar-gutter:stable]"
                        data-slot="code-block-content"
                        data-wrap="true"
                        dir="ltr"
                        style="counter-reset: line 0;"
                        tabindex="0"
                      >
                        <code
                          class="grid min-h-lh min-w-max content-start in-data-numbered:grid-cols-[auto_1fr] in-data-wrap:min-w-0"
                          data-slot="code-block-code"
                        >
                          <span
                            class="relative -mx-3 block min-h-lh px-3 group-data-[size=sm]/code-block:-mx-2.5 group-data-[size=sm]/code-block:px-2.5 before:min-w-6 before:text-end before:text-muted-foreground after:absolute after:start-1 after:top-0 after:text-muted-foreground after:select-none in-data-numbered:col-span-2 in-data-numbered:grid in-data-numbered:grid-cols-subgrid in-data-numbered:gap-x-3 in-data-numbered:[counter-increment:line] in-data-numbered:before:content-[counter(line)] in-data-numbered:before:select-none in-data-numbered:supports-[content:counter(line)_/_'']:before:content-[counter(line)_/_'']"
                            data-slot="code-block-line"
                            data-variant="default"
                          >
                            <span
                              class="min-w-0"
                              data-slot="code-block-line-content"
                            >
                              <span
                                class="text-(--shiki-light) dark:text-(--shiki-dark)"
                                style="--shiki-light: #24292E; --shiki-dark: #E1E4E8;"
                              >
                                boom
                              </span>
                            </span>
                          </span>
                        </code>
                      </pre>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>"
`;

