// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ChatMessageView, pinned > PeerIncomingCard on its own > markup 1`] = `
"<div>
  <div
    class="group/message relative flex w-full min-w-0 text-sm data-[align=end]:flex-row-reverse group flex-col gap-1.5"
    data-align="start"
    data-peer="Radar"
    data-slot="message"
    data-testid="peer-card"
  >
    <p
      class="text-muted-foreground flex items-center justify-center gap-1.5 py-1 text-xs"
    >
      <img
        alt=""
        aria-hidden="true"
        class="shrink-0 rounded-full bg-muted size-4"
        loading="lazy"
        src="https://api.dicebear.com/10.x/gaze/svg?seed=Radar"
      />
      <span
        class="text-foreground/80 font-medium"
      >
        Radar
      </span>
      <span
        aria-hidden="true"
      >
        ·
      </span>
      <span>
        messaged you
      </span>
    </p>
    <div
      class="flex min-w-0 items-center gap-2"
    >
      <div
        class="bg-bubble chat-md min-w-0 max-w-[92%] md:max-w-[80%] rounded-3xl px-4 py-2"
        data-slot="reply-card"
      >
        <div
          class="space-y-4 whitespace-normal [&>*:first-child]:mt-0 [&>*:last-child]:mb-0"
        >
          <p>
            hi
          </p>
        </div>
      </div>
      <div
        class="flex shrink-0 flex-col items-center gap-0.5"
      >
        <button
          aria-label="Copy message"
          class="text-muted-foreground hover:bg-accent hover:text-foreground flex size-6 shrink-0 items-center justify-center rounded-full opacity-0 group-hover:opacity-100 focus-visible:opacity-100 pointer-coarse:opacity-100"
          type="button"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-copy size-3.5"
            fill="none"
            height="24"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="24"
            xmlns="http://www.w3.org/2000/svg"
          />
        </button>
      </div>
    </div>
  </div>
</div>"
`;

exports[`ChatMessageView, pinned > PeerIncomingCard on its own > outline 1`] = `
