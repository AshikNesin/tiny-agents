                                style="font-variation-settings: \\"wght\\" 400, \\"opsz\\" 14; height: 0px;"
                              />
                            </span>
                          </span>
                          <span
                            class="shrink-0 relative inline-flex items-center justify-center w-7 h-7"
                          >
                            <span
                              aria-hidden="true"
                              class="absolute inline-flex items-center justify-center text-[length:var(--fs-micro,11px)] leading-[var(--lh-micro,14px)] transition-[opacity,font-variation-settings] duration-80 w-5 h-5 text-muted-foreground"
                              style="font-variation-settings: \\"wght\\" 400, \\"opsz\\" 14;"
                            >
                              3
                            </span>
                          </span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <p
              class="text-muted-foreground px-1 text-xs"
            >
              Or reply in the chat to skip these questions.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>"
`;

