              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="24"
              xmlns="http://www.w3.org/2000/svg"
            />
          </button>
          <time
            class="text-muted-foreground text-xs tabular-nums whitespace-nowrap"
            datetime="2026-11-06T06:00:00.000Z"
            title="Friday, November 6, 2026 at 6:00 AM"
          >
            06:00 AM
          </time>
        </div>
      </div>
    </div>
  </div>
</div>"
`;

