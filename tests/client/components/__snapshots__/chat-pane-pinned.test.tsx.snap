            <svg
              aria-hidden="true"
              class="lucide lucide-globe size-3.5"
              fill="none"
              height="24"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="24"
              xmlns="http://www.w3.org/2000/svg"
            />
            <span
              class="@max-lg:sr-only"
            >
              Browser
            </span>
          </button>
          <button
            aria-selected="true"
            class="relative inline-flex h-6 items-center gap-1.5 rounded-md px-2 text-xs font-medium text-muted-foreground outline-none hover:text-foreground focus-visible:ring-3 focus-visible:ring-ring/50 aria-selected:bg-background aria-selected:text-foreground aria-selected:shadow-sm"
            data-testid="live-view-tab-computer"
            role="tab"
            type="button"
          >
            <svg
              aria-hidden="true"
              class="lucide lucide-monitor size-3.5"
              fill="none"
              height="24"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="24"
              xmlns="http://www.w3.org/2000/svg"
            />
            <span
              class="@max-lg:sr-only"
            >
              Computer
            </span>
          </button>
        </div>
        <button
          type="button"
        >
          Close computer stand-in
        </button>
      </aside>
    </div>
  </div>
</body>"
`;

exports[`ChatPane, pinned > a computer: the toggle, then the tabs > computer in front outline 1`] = `
"banner
  button "Open menu"
    icon lucide-menu
  heading "Host Bot"
    button "Host Bot menu" [title="Helps with things", aria-expanded=false, aria-haspopup=menu]
      img [aria-hidden=true]
      "Host Bot"
      icon lucide-chevron-down
  button "Close live view" [testid=live-view-toggle, title="Live view"]
    icon lucide-monitor-play
  button "Past chats" [title="Past chats (h)"]
    icon lucide-rotate-ccw-clock lucide-history
  button "Start a new chat" [title="New chat (n or Ctrl+Shift+O)", disabled]
    icon lucide-square-pen lucide-pen-box lucide-edit lucide-pen-square
region "Messages"
  log
    img [aria-hidden=true]
    "Host Bot"
    "Helps with things"
    div [aria-hidden=true]
button "Jump to the latest message"
  icon lucide-arrow-down
  "Scroll to end"
input "Attach files" [testid=file-input]
textbox
button "Add files or mention a bot" [testid=composer-add, title="Add files or mention a bot", aria-expanded=false, aria-haspopup=menu]
  icon lucide-plus
button "Model" [testid=chat-model, title="Model", aria-expanded=false, aria-haspopup=dialog]
  icon lucide-cpu
  "Test Model"
  icon lucide-chevron-down
button "YOLO" [testid=yolo-chip, title="Run tools without asking"]
  icon lucide-zap
  "YOLO"
button "Send message" [disabled]
  icon lucide-arrow-up
p [testid=composer-hint, aria-hidden=true]
  "Type @ to tag another bot"
complementary
  tablist "Live view"
    tab "Browser" [testid=live-view-tab-browser, aria-selected=false]
      icon lucide-globe
      "Browser"
    tab "Computer" [testid=live-view-tab-computer, aria-selected=true]
      icon lucide-monitor
      "Computer"
  button "Close computer stand-in"
    "Close computer stand-in""
`;

