            data-slot="message-scroller"
          >
            <div
              aria-label="Messages"
              class="size-full min-h-0 min-w-0 scroll-fade-b overflow-y-auto overscroll-contain contain-content [scrollbar-gutter:stable] [scrollbar-width:thin] data-autoscrolling:[scrollbar-color:transparent_transparent] data-pending-scroll:invisible mx-auto w-full max-w-3xl px-4 pt-6 pb-4 sm:px-6"
              data-slot="message-scroller-viewport"
              role="region"
              tabindex="0"
            >
              <div
                aria-relevant="additions"
                class="flex h-max min-h-full flex-col gap-4"
                data-slot="message-scroller-content"
                role="log"
              >
                <div
                  class="text-muted-foreground flex justify-center py-2 text-xs"
                >
                  Today
                </div>
                <div
                  class="min-w-0 shrink-0 [contain-intrinsic-size:auto_10rem] [content-visibility:auto]"
                  data-message-id="u1"
                  data-scroll-anchor="false"
                  data-slot="message-scroller-item"
                >
                  <div
                    class="group/message relative flex w-full min-w-0 gap-2 text-sm data-[align=end]:flex-row-reverse group"
                    data-align="end"
                    data-slot="message"
                  >
                    <div
                      class="flex max-w-[92%] md:max-w-[80%] min-w-0 flex-col gap-1 items-end"
                      style="transform-origin: right bottom;"
                    >
                      <div
                        class="bg-bubble-user text-bubble-user-foreground min-w-0 max-w-full rounded-2xl px-3.5 py-2 text-[15px] leading-[22.5px] wrap-break-word text-pretty"
                      >
                        <p
                          class="whitespace-pre-wrap"
                        >
                          hi
                        </p>
                      </div>
                      <div
                        class="-mt-0.5 flex h-6 items-center gap-1.5 px-1 opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 pointer-coarse:opacity-100 flex-row-reverse"
                        data-slot="message-meta"
                      >
                        <button
                          aria-label="Copy message"
                          class="text-muted-foreground hover:bg-accent hover:text-foreground flex size-6 shrink-0 items-center justify-center rounded-full opacity-0 group-hover:opacity-100 focus-visible:opacity-100 pointer-coarse:opacity-100"
                          type="button"
                        >
                          <svg
                            aria-hidden="true"
                            class="lucide lucide-copy size-3.5"
                            fill="none"
                            height="24"
                            stroke="currentColor"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            viewBox="0 0 24 24"
                            width="24"
                            xmlns="http://www.w3.org/2000/svg"
                          />
                        </button>
                        <time
                          class="text-muted-foreground text-xs tabular-nums whitespace-nowrap"
                          datetime="2026-11-06T06:20:00.000Z"
                          title="Friday, November 6, 2026 at 6:20 AM"
                        >
                          06:20 AM
                        </time>
                      </div>
                    </div>
                  </div>
                </div>
                <div
                  aria-hidden="true"
                  data-message-scroller-spacer=""
                  hidden=""
                />
              </div>
            </div>
            <button
              aria-label="Jump to the latest message"
              class="group/button inline-flex shrink-0 items-center justify-center rounded-xl border bg-clip-padding text-sm font-medium whitespace-nowrap ease-[cubic-bezier(0.23,1,0.32,1)] outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:scale-[0.97] motion-reduce:transition-none disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 aria-expanded:bg-secondary aria-expanded:text-secondary-foreground size-7 in-data-[slot=button-group]:rounded-lg inset-s-1/2 -translate-x-1/2 border-border bg-background text-foreground transition-[translate,scale,opacity] duration-200 hover:bg-muted hover:text-foreground data-[active=false]:pointer-events-none data-[active=false]:scale-95 data-[active=false]:opacity-0 data-[active=false]:duration-400 data-[active=false]:ease-[cubic-bezier(0.7,0,0.84,0)] data-[active=true]:translate-y-0 data-[active=true]:scale-100 data-[active=true]:opacity-100 data-[active=true]:ease-[cubic-bezier(0.23,1,0.32,1)] data-[direction=end]:bottom-4 data-[direction=end]:data-[active=false]:translate-y-full data-[direction=start]:top-4 data-[direction=start]:data-[active=false]:-translate-y-full rtl:translate-x-1/2 data-[direction=start]:[&_svg]:rotate-180 absolute right-4 bottom-4"
              data-active="false"
              data-direction="end"
              data-size="icon-sm"
              data-slot="message-scroller-button"
              data-variant="secondary"
              inert=""
              tabindex="-1"
              type="button"
            >
              <svg
                aria-hidden="true"
                class="lucide lucide-arrow-down"
                fill="none"
                height="24"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="24"
