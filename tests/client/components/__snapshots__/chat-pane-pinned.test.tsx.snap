                  <button
                    aria-pressed="false"
                    class="inline-flex h-7 shrink-0 items-center gap-1 rounded-full px-2 text-xs font-medium outline-none focus-visible:ring-1 focus-visible:ring-ring [&_svg]:size-3.5 text-muted-foreground hover:text-foreground hover:bg-muted"
                    data-testid="yolo-chip"
                    title="Run tools without asking"
                    type="button"
                  >
                    <svg
                      aria-hidden="true"
                      class="lucide lucide-zap opacity-70"
