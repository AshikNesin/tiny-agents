                  data-size="icon-sm"
                  data-slot="dropdown-menu-trigger"
                  data-state="closed"
                  data-testid="composer-add"
                  data-variant="ghost"
                  id="radix-<id2>"
                  title="Add files or mention a bot"
                  type="button"
                >
                  <svg
                    aria-hidden="true"
                    class="lucide lucide-plus"
                    fill="none"
                    height="24"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                    width="24"
                    xmlns="http://www.w3.org/2000/svg"
                  />
                </button>
                <div
                  class="@container flex min-w-0 flex-1 items-center gap-0.5 overflow-hidden"
                >
                  <button
                    aria-expanded="false"
                    aria-haspopup="dialog"
                    aria-label="Model"
                    class="text-muted-foreground hover:text-foreground hover:bg-muted aria-expanded:bg-muted aria-expanded:text-foreground focus-visible:ring-ring/50 inline-flex h-7 min-w-0 shrink items-center gap-1 rounded-lg px-2 text-xs font-medium outline-none select-none focus-visible:ring-3 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-3.5"
                    data-state="closed"
                    data-testid="chat-model"
                    title="Model"
                    type="button"
                  >
                    <svg
                      aria-hidden="true"
                      class="lucide lucide-cpu opacity-70"
                      fill="none"
                      height="24"
                      stroke="currentColor"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      width="24"
                      xmlns="http://www.w3.org/2000/svg"
                    />
                    <span
                      class="max-w-28 truncate @xs:max-w-48"
                    >
                      Test Model
                    </span>
                    <svg
                      aria-hidden="true"
                      class="lucide lucide-chevron-down opacity-50"
                      fill="none"
                      height="24"
                      stroke="currentColor"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      width="24"
                      xmlns="http://www.w3.org/2000/svg"
                    />
                  </button>
                  <button
                    aria-pressed="false"
                    class="inline-flex h-7 shrink-0 items-center gap-1 rounded-full px-2 text-xs font-medium outline-none focus-visible:ring-1 focus-visible:ring-ring [&_svg]:size-3.5 text-muted-foreground hover:text-foreground hover:bg-muted"
                    data-testid="yolo-chip"
                    title="Run tools without asking"
                    type="button"
