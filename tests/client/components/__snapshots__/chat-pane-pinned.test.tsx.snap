              data-testid="composer-hint"
            >
              Enter steers · Alt+Enter queues · Esc stops
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>"
`;

exports[`ChatPane, pinned > messages held over the composer > outline 1`] = `
"banner
  button "Open menu"
    icon lucide-menu
  heading "Host Bot"
    button "Host Bot menu" [title="Helps with things", aria-expanded=false, aria-haspopup=menu]
      img [aria-hidden=true]
      "Host Bot"
      icon lucide-chevron-down
  button "Open live view" [testid=live-view-toggle, title="Live view"]
    icon lucide-globe
  button "Past chats" [title="Past chats (h)"]
    icon lucide-rotate-ccw-clock lucide-history
  button "Start a new chat" [title="New chat (n or Ctrl+Shift+O)"]
    icon lucide-square-pen lucide-pen-box lucide-edit lucide-pen-square
region "Messages"
  log
    "Today"
    "hi"
    button "Copy message"
      icon lucide-copy
    time [title="Friday, November 6, 2026 at 6:20 AM"]
      "06:20 AM"
    status "Host Bot is typing…" [testid=typing-indicator]
      "Host Bot is typing…"
      icon svg
      span [aria-hidden=true]
        "Thinking"
        "Thinking"
    div [aria-hidden=true]
button "Jump to the latest message"
  icon lucide-arrow-down
  "Scroll to end"
list "Waiting to send"
  listitem [testid=queued-bubble]
    "Steering"
    span [title="this too"]
      "this too"
    button "Cancel this message" [title="Joins the running reply · cancel"]
      icon lucide-x
  listitem [testid=queued-bubble]
    "Queued"
    span [title="and later"]
      "and later"
    icon lucide-paperclip
    "1"
    button "Cancel this message" [title="Sent after this reply · cancel"]
      icon lucide-x
input "Attach files" [testid=file-input]
textbox
button "Add files or mention a bot" [testid=composer-add, title="Add files or mention a bot", aria-expanded=false, aria-haspopup=menu]
  icon lucide-plus
button "Model" [testid=chat-model, title="Model", aria-expanded=false, aria-haspopup=dialog]
  icon lucide-cpu
  "Test Model"
  icon lucide-chevron-down
button "YOLO" [testid=yolo-chip, title="Run tools without asking"]
  icon lucide-zap
  "YOLO"
button "Stop generating" [title="Stop generating (Esc)"]
  icon lucide-square
p [testid=composer-hint, aria-hidden=false]
  "Enter steers · Alt+Enter queues · Esc stops""
`;

