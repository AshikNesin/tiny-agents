exports[`ChatPane, pinned > an empty chat > outline 1`] = `
"banner
  button "Open menu"
    icon lucide-menu
  heading "Host Bot"
    button "Host Bot menu" [title="Helps with things", aria-expanded=false, aria-haspopup=menu]
      img [aria-hidden=true]
      "Host Bot"
      icon lucide-chevron-down
  button "Open live view" [testid=live-view-toggle, title="Live view"]
    icon lucide-globe
  button "Past chats" [title="Past chats (h)"]
    icon lucide-rotate-ccw-clock lucide-history
  button "Start a new chat" [title="New chat (n or Ctrl+Shift+O)", disabled]
    icon lucide-square-pen lucide-pen-box lucide-edit lucide-pen-square
region "Messages"
  log
    img [aria-hidden=true]
    "Host Bot"
    "Helps with things"
    div [aria-hidden=true]
button "Jump to the latest message"
  icon lucide-arrow-down
  "Scroll to end"
input "Attach files" [testid=file-input]
textbox
button "Add files or mention a bot" [testid=composer-add, title="Add files or mention a bot", aria-expanded=false, aria-haspopup=menu]
  icon lucide-plus
button "Model" [testid=chat-model, title="Model", aria-expanded=false, aria-haspopup=dialog]
  icon lucide-cpu
  "Test Model"
  icon lucide-chevron-down
button "YOLO" [testid=yolo-chip, title="Run tools without asking"]
  icon lucide-zap
  "YOLO"
button "Send message" [disabled]
  icon lucide-arrow-up
p [testid=composer-hint, aria-hidden=true]
  "Type @ to tag another bot""
`;

