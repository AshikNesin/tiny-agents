              data-slot="composer-frame"
            >
              <textarea
                class="placeholder:text-fg-tertiary field-sizing-content max-h-60 min-h-[2.75rem] w-full resize-none overflow-y-auto bg-transparent px-2 pt-1.5 text-base leading-7 outline-none disabled:opacity-50 md:text-sm md:leading-6"
                placeholder="Message Host Bot"
                rows="1"
              />
              <div
                class="flex min-w-0 items-center gap-1"
              >
                <button
                  aria-expanded="false"
                  aria-haspopup="menu"
                  aria-label="Add files or mention a bot"
                  class="group/button inline-flex items-center justify-center border border-transparent bg-clip-padding text-sm font-medium whitespace-nowrap transition-transform duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:scale-[0.97] motion-reduce:transition-none disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 hover:bg-muted hover:text-foreground aria-expanded:bg-muted aria-expanded:text-foreground dark:hover:bg-muted/50 size-7 in-data-[slot=button-group]:rounded-lg text-muted-foreground shrink-0 rounded-full"
                  data-size="icon-sm"
                  data-slot="dropdown-menu-trigger"
                  data-state="closed"
                  data-testid="composer-add"
                  data-variant="ghost"
                  id="radix-<id2>"
                  title="Add files or mention a bot"
                  type="button"
                >
                  <svg
                    aria-hidden="true"
                    class="lucide lucide-plus"
                    fill="none"
                    height="24"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                    width="24"
                    xmlns="http://www.w3.org/2000/svg"
                  />
                </button>
                <div
                  class="@container flex min-w-0 flex-1 items-center gap-0.5 overflow-hidden"
                >
                  <button
                    aria-expanded="false"
                    aria-haspopup="dialog"
                    aria-label="Model"
                    class="text-muted-foreground hover:text-foreground hover:bg-muted aria-expanded:bg-muted aria-expanded:text-foreground focus-visible:ring-ring/50 inline-flex h-7 min-w-0 shrink items-center gap-1 rounded-lg px-2 text-xs font-medium outline-none select-none focus-visible:ring-3 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-3.5"
                    data-state="closed"
                    data-testid="chat-model"
                    title="Model"
                    type="button"
                  >
                    <svg
                      aria-hidden="true"
                      class="lucide lucide-cpu opacity-70"
                      fill="none"
                      height="24"
                      stroke="currentColor"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      width="24"
                      xmlns="http://www.w3.org/2000/svg"
                    />
                    <span
                      class="max-w-28 truncate @xs:max-w-48"
                    >
                      Test Model
                    </span>
                    <svg
                      aria-hidden="true"
                      class="lucide lucide-chevron-down opacity-50"
                      fill="none"
                      height="24"
                      stroke="currentColor"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      width="24"
                      xmlns="http://www.w3.org/2000/svg"
                    />
                  </button>
                  <button
                    aria-pressed="false"
                    class="inline-flex h-7 shrink-0 items-center gap-1 rounded-full px-2 text-xs font-medium outline-none focus-visible:ring-1 focus-visible:ring-ring [&_svg]:size-3.5 text-muted-foreground hover:text-foreground hover:bg-muted"
                    data-testid="yolo-chip"
                    title="Run tools without asking"
                    type="button"
                  >
                    <svg
                      aria-hidden="true"
                      class="lucide lucide-zap opacity-70"
                      fill="none"
                      height="24"
                      stroke="currentColor"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      width="24"
                      xmlns="http://www.w3.org/2000/svg"
                    />
                    YOLO
                  </button>
                </div>
                <div
                  class="shrink-0"
                >
                  <button
                    aria-label="Send message"
                    class="group/button inline-flex shrink-0 items-center justify-center border border-transparent bg-clip-padding text-sm font-medium whitespace-nowrap transition-transform duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:scale-[0.97] motion-reduce:transition-none disabled:pointer-events-none aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 bg-primary text-primary-foreground hover:bg-primary/80 size-8 rounded-full disabled:opacity-30"
                    data-size="icon"
                    data-slot="button"
                    data-variant="default"
                    disabled=""
                  >
                    <span
                      class="flex items-center justify-center leading-none"
                    >
                      <svg
                        aria-hidden="true"
                        class="lucide lucide-arrow-up size-4"
                        fill="none"
                        height="24"
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                        width="24"
                        xmlns="http://www.w3.org/2000/svg"
                      />
                    </span>
                  </button>
                </div>
              </div>
            </div>
            <p
              aria-hidden="true"
              class="text-muted-foreground pointer-events-none absolute inset-x-0 top-full mt-1 truncate text-center text-[11px] leading-4 transition-opacity duration-200 opacity-0"
              data-testid="composer-hint"
            >
              Type @ to tag another bot
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>"
`;

exports[`ChatPane, pinned > a conversation > outline 1`] = `
"banner
  button "Open menu"
    icon lucide-menu
  heading "Host Bot"
    button "Host Bot menu" [title="Helps with things", aria-expanded=false, aria-haspopup=menu]
      img [aria-hidden=true]
      "Host Bot"
      icon lucide-chevron-down
  button "Open live view" [testid=live-view-toggle, title="Live view"]
    icon lucide-globe
  button "Past chats" [title="Past chats (h)"]
    icon lucide-rotate-ccw-clock lucide-history
  button "Start a new chat" [title="New chat (n or Ctrl+Shift+O)"]
    icon lucide-square-pen lucide-pen-box lucide-edit lucide-pen-square
region "Messages"
  log
    "Today"
    "hi"
    button "Copy message"
      icon lucide-copy
    time [title="Friday, November 6, 2026 at 6:20 AM"]
      "06:20 AM"
    div [testid=unread-divider]
      span [aria-hidden=true]
      "New messages"
      span [aria-hidden=true]
    "hello"
    button "Copy message"
      icon lucide-copy
    time [title="Friday, November 6, 2026 at 6:20 AM"]
      "06:20 AM"
    div [aria-hidden=true]
button "Jump to the latest message"
  icon lucide-arrow-down
  "Scroll to end"
input "Attach files" [testid=file-input]
textbox
button "Add files or mention a bot" [testid=composer-add, title="Add files or mention a bot", aria-expanded=false, aria-haspopup=menu]
  icon lucide-plus
button "Model" [testid=chat-model, title="Model", aria-expanded=false, aria-haspopup=dialog]
  icon lucide-cpu
  "Test Model"
  icon lucide-chevron-down
button "YOLO" [testid=yolo-chip, title="Run tools without asking"]
  icon lucide-zap
  "YOLO"
button "Send message" [disabled]
  icon lucide-arrow-up
p [testid=composer-hint, aria-hidden=true]
  "Type @ to tag another bot""
`;

