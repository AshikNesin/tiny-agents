                    <svg
                      aria-hidden="true"
                      class="lucide lucide-chevron-down opacity-50"
                      fill="none"
                      height="24"
                      stroke="currentColor"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
