                  data-size="icon-sm"
                  data-slot="dropdown-menu-trigger"
                  data-state="closed"
                  data-testid="composer-add"
                  data-variant="ghost"
                  id="radix-<id2>"
                  title="Add files or mention a bot"
                  type="button"
                >
                  <svg
                    aria-hidden="true"
                    class="lucide lucide-plus"
                    fill="none"
                    height="24"
