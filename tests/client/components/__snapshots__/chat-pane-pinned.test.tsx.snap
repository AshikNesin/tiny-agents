                  data-slot="message-scroller-item"
                >
                  <div
                    class="group/message relative flex w-full min-w-0 gap-2 text-sm data-[align=end]:flex-row-reverse group"
                    data-align="start"
                    data-slot="message"
                  >
                    <div
                      class="min-w-0 flex-1"
                    >
                      <div
                        class="mb-2 space-y-1"
                      >
                        <div
                          class="flex w-full min-w-0 flex-col *:has-[>[data-slot=trace-line]]:flex *:has-[>[data-slot=trace-line]]:w-fit *:has-[>[data-slot=trace-line]]:max-w-full *:has-[>[data-slot=trace-line]]:min-w-0 *:has-[>[data-slot=trace-line]]:rounded-md *:has-[>[data-slot=trace-line]]:text-left *:has-[>[data-slot=trace-line]]:outline-none *:has-[>[data-slot=trace-line]]:focus-visible:ring-3 *:has-[>[data-slot=trace-line]]:focus-visible:ring-ring/50 gap-1"
                          data-slot="trace"
                        >
                          <span
                            class="flex w-fit max-w-full min-w-0 items-center gap-2 text-sm text-muted-foreground in-[a,button]:cursor-pointer in-[a:hover,button:hover]:text-foreground data-[status=error]:text-destructive data-[status=error]:in-[a:hover,button:hover]:text-destructive data-[status=pending]:opacity-60 data-[status=running]:*:data-[slot=trace-title]:shimmer"
                            data-slot="trace-line"
                            data-status="running"
                          >
                            <span
                              class="min-w-0 truncate motion-reduce:shimmer-none"
                              data-slot="trace-title"
                            >
                              browser navigate
                            </span>
                          </span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div
