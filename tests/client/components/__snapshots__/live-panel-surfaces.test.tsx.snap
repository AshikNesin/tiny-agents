                xmlns="http://www.w3.org/2000/svg"
              />
            </div>
            <p
              class="text-sm font-medium text-foreground"
            >
              Setting up the computer on the VM
            </p>
            <p
              class="mt-1 text-xs text-muted-foreground"
            >
              <span
                class="mx-auto block max-w-sm"
              >
                First run only: installing the desktop and its tools. This takes a few minutes.
              </span>
            </p>
            <div
              class="mt-4 flex items-center gap-2"
            >
              <output
                aria-label="Loading"
                class="animate-spin rounded-full border-muted border-t-foreground size-4 border-2"
              >
                <span
                  class="sr-only"
                >
                  Loading...
                </span>
              </output>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>"
`;

exports[`ComputerPanel states > first-run setup > outline 1`] = `
