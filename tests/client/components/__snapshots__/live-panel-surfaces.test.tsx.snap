"div [testid=browser-panel]
  separator "Resize browser panel" [testid=browser-resize, aria-orientation=vertical]
  banner
    heading "Browser"
      "Browser"
    span [aria-live=polite]
      span [aria-hidden=true]
      span [testid=browser-driver]
        "Surfer is driving"
    button "Full screen" [testid=browser-fullscreen, title="Full screen"]
      icon lucide-maximize-2
    link "Open in the Browser page" [testid=browser-open-page, title="Open in the Browser page", href=/browser?profile=shared]
      icon lucide-square-arrow-out-up-right lucide-arrow-up-right-from-square
    button "Reset browser profile" [testid=browser-reset, title="Close the shared browser and wipe its profile (every bot on it)"]
      icon lucide-rotate-ccw
    button "Close browser panel" [title="Close panel"]
      icon lucide-x
  div [testid=browser-viewport]
    div [testid=browser-vnc]
    button "Take control" [testid=browser-takeover, title="Click and type in the browser yourself. Surfer waits."]
      icon lucide-mouse-pointer-click
      "Click to take control""
`;

exports[`BrowserPanel states > live, the owner driving > markup 1`] = `
"<body>
  <div>
    <div
      class="flex flex-col fixed inset-0 z-40 bg-background xl:static xl:z-auto xl:h-full xl:w-[min(var(--browser-panel-width),calc(100vw-42rem))] xl:shrink-0 xl:bg-transparent xl:p-2 xl:pl-0"
      data-testid="browser-panel"
      style="--browser-panel-width: 360px;"
    >
      <div
        aria-label="Resize browser panel"
        aria-orientation="vertical"
        class="absolute inset-y-0 left-0 z-10 hidden w-1.5 -translate-x-1/2 cursor-col-resize hover:bg-border xl:block"
        data-testid="browser-resize"
        role="separator"
      />
      <div
        class="group/card flex flex-col overflow-hidden rounded-2xl bg-card text-sm text-card-foreground ring-1 ring-foreground/10 [--card-spacing:--spacing(4)] has-data-[slot=card-footer]:pb-0 has-[>img:first-child]:pt-0 data-[size=sm]:[--card-spacing:--spacing(3)] data-[size=sm]:has-data-[slot=card-footer]:pb-0 *:[img:first-child]:rounded-t-2xl *:[img:last-child]:rounded-b-2xl min-h-0 flex-1 gap-0 py-0 max-xl:rounded-none max-xl:ring-0"
        data-size="sm"
        data-slot="card"
      >
        <header
          class="@container flex h-11 shrink-0 items-center gap-2 border-b pr-1.5 pl-2"
        >
          <div
            class="flex min-w-0 flex-1 items-center gap-2"
          >
            <h3
              class="font-heading font-medium group-data-[size=sm]/card:text-sm pl-1 text-sm"
              data-slot="card-title"
            >
              Browser
            </h3>
            <span
              aria-live="polite"
              class="inline-flex h-6 min-w-0 shrink items-center gap-1.5 rounded-full px-2 text-xs font-medium bg-success/10 text-success"
            >
              <span
                aria-hidden="true"
                class="relative flex size-1.5 shrink-0"
              >
                <span
                  class="absolute inset-0 animate-ping rounded-full bg-success opacity-75"
                />
                <span
                  class="relative size-1.5 rounded-full bg-success"
                />
              </span>
              <span
                class="truncate @max-md:sr-only"
                data-testid="browser-driver"
              >
                You're driving
              </span>
            </span>
          </div>
          <div
            class="flex shrink-0 items-center gap-0.5"
          >
            <button
              class="group/button inline-flex shrink-0 items-center justify-center rounded-xl border border-transparent bg-clip-padding font-medium whitespace-nowrap transition-transform duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:scale-[0.97] motion-reduce:transition-none disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&_svg]:pointer-events-none [&_svg]:shrink-0 bg-secondary text-secondary-foreground hover:bg-[color-mix(in_oklch,var(--secondary),var(--foreground)_5%)] aria-expanded:bg-secondary aria-expanded:text-secondary-foreground h-6 gap-1 px-2 text-xs in-data-[slot=button-group]:rounded-lg has-data-[icon=inline-end]:pr-1.5 has-data-[icon=inline-start]:pl-1.5 [&_svg:not([class*='size-'])]:size-3 mr-1"
              data-size="xs"
              data-slot="button"
              data-testid="browser-release"
              data-variant="secondary"
              title="Hand the browser back to Surfer"
            >
              <svg
                aria-hidden="true"
                class="lucide lucide-undo-2"
                fill="none"
                height="24"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="24"
                xmlns="http://www.w3.org/2000/svg"
              />
              Hand back
            </button>
            <button
              aria-label="Paste from your clipboard"
              class="group/button inline-flex shrink-0 items-center justify-center rounded-xl border border-transparent bg-clip-padding text-sm font-medium whitespace-nowrap transition-transform duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:scale-[0.97] motion-reduce:transition-none disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 hover:bg-muted aria-expanded:bg-muted aria-expanded:text-foreground dark:hover:bg-muted/50 size-7 in-data-[slot=button-group]:rounded-lg text-muted-foreground hover:text-foreground"
              data-size="icon-sm"
              data-slot="button"
              data-testid="browser-paste"
              data-variant="ghost"
              title="Paste from your clipboard"
            >
              <svg
                aria-hidden="true"
                class="lucide lucide-clipboard-paste size-3.5"
                fill="none"
                height="24"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="24"
                xmlns="http://www.w3.org/2000/svg"
              />
            </button>
            <button
              aria-label="Full screen"
              class="group/button inline-flex shrink-0 items-center justify-center rounded-xl border border-transparent bg-clip-padding text-sm font-medium whitespace-nowrap transition-transform duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:scale-[0.97] motion-reduce:transition-none disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 hover:bg-muted aria-expanded:bg-muted aria-expanded:text-foreground dark:hover:bg-muted/50 size-7 in-data-[slot=button-group]:rounded-lg text-muted-foreground hover:text-foreground"
              data-size="icon-sm"
              data-slot="button"
              data-testid="browser-fullscreen"
              data-variant="ghost"
              title="Full screen"
            >
              <svg
                aria-hidden="true"
                class="lucide lucide-maximize-2 size-3.5"
                fill="none"
                height="24"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="24"
                xmlns="http://www.w3.org/2000/svg"
              />
            </button>
            <a
              aria-label="Open in the Browser page"
              class="group/button inline-flex shrink-0 items-center justify-center rounded-xl border border-transparent bg-clip-padding text-sm font-medium whitespace-nowrap transition-transform duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:scale-[0.97] motion-reduce:transition-none disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 hover:bg-muted aria-expanded:bg-muted aria-expanded:text-foreground dark:hover:bg-muted/50 size-7 in-data-[slot=button-group]:rounded-lg text-muted-foreground hover:text-foreground"
              data-discover="true"
              data-size="icon-sm"
              data-slot="button"
              data-testid="browser-open-page"
              data-variant="ghost"
              href="/browser?profile=shared"
              title="Open in the Browser page"
            >
              <svg
                aria-hidden="true"
                class="lucide lucide-square-arrow-out-up-right lucide-arrow-up-right-from-square size-3.5"
                fill="none"
                height="24"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="24"
                xmlns="http://www.w3.org/2000/svg"
              />
            </a>
            <button
              aria-label="Reset browser profile"
              class="group/button inline-flex shrink-0 items-center justify-center rounded-xl border border-transparent bg-clip-padding text-sm font-medium whitespace-nowrap transition-transform duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:scale-[0.97] motion-reduce:transition-none disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 hover:bg-muted aria-expanded:bg-muted aria-expanded:text-foreground dark:hover:bg-muted/50 size-7 in-data-[slot=button-group]:rounded-lg text-muted-foreground hover:text-foreground"
              data-size="icon-sm"
              data-slot="button"
              data-testid="browser-reset"
              data-variant="ghost"
              title="Close the shared browser and wipe its profile (every bot on it)"
            >
              <svg
                aria-hidden="true"
                class="lucide lucide-rotate-ccw size-3.5"
                fill="none"
                height="24"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="24"
                xmlns="http://www.w3.org/2000/svg"
              />
            </button>
            <button
              aria-label="Close browser panel"
              class="group/button inline-flex shrink-0 items-center justify-center rounded-xl border border-transparent bg-clip-padding text-sm font-medium whitespace-nowrap transition-transform duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:scale-[0.97] motion-reduce:transition-none disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 hover:bg-muted aria-expanded:bg-muted aria-expanded:text-foreground dark:hover:bg-muted/50 size-7 in-data-[slot=button-group]:rounded-lg text-muted-foreground hover:text-foreground"
              data-size="icon-sm"
