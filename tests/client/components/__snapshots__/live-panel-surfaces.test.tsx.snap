                width="24"
                xmlns="http://www.w3.org/2000/svg"
              />
            </button>
          </div>
        </header>
        <div
          class="relative min-h-0 flex-1 overflow-hidden"
          data-testid="browser-viewport"
        >
          <div
            class="bg-muted absolute inset-0"
            data-testid="browser-vnc"
          />
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 ring-2 ring-success ring-inset"
            data-testid="browser-driving-frame"
          />
        </div>
      </div>
    </div>
  </div>
</body>"
`;

