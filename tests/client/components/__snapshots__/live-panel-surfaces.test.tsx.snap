              data-variant="ghost"
              title="Close panel"
            >
              <svg
                aria-hidden="true"
                class="lucide lucide-x size-3.5"
                fill="none"
                height="24"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="24"
                xmlns="http://www.w3.org/2000/svg"
              />
            </button>
          </div>
        </header>
        <div
          class="flex shrink-0 items-start gap-2 border-b bg-primary/5 px-4 py-2 text-sm"
          data-testid="computer-takeover-reason"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-hand mt-0.5 size-4 shrink-0 text-primary"
            fill="none"
            height="24"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="24"
            xmlns="http://www.w3.org/2000/svg"
          />
          <span
            class="min-w-0"
          >
            <span
              class="font-medium"
            >
              Surfer asked you:
            </span>
             Sign in to the mail app 
            <span
              class="text-muted-foreground"
            >
              It sees nothing until you press I'm done.
            </span>
          </span>
        </div>
        <div
          class="relative min-h-0 flex-1 overflow-hidden"
          data-testid="computer-viewport"
        >
          <div
            class="bg-muted absolute inset-0"
            data-testid="computer-vnc"
          />
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 ring-2 ring-success ring-inset"
            data-testid="computer-driving-frame"
          />
        </div>
      </div>
    </div>
  </div>
</body>"
`;

exports[`ComputerPanel states > live, the owner driving at the bot's request > outline 1`] = `
"div [testid=computer-panel]
  separator "Resize computer panel" [aria-orientation=vertical]
  banner
    heading "Computer"
      "Computer"
    span [aria-live=polite]
      span [aria-hidden=true]
      span [testid=computer-driver]
        "You're driving"
    button "I'm done" [testid=computer-release, title="Hand the computer back to Surfer"]
      icon lucide-undo-2
      "I'm done"
    button "Paste from your clipboard" [testid=computer-paste, title="Paste from your clipboard"]
      icon lucide-clipboard-paste
    button "Full screen" [testid=computer-fullscreen, title="Full screen"]
      icon lucide-maximize-2
    link "Open the Computer page" [testid=computer-open-page, title="Open the Computer page", href=/computer]
      icon lucide-square-arrow-out-up-right lucide-arrow-up-right-from-square
    button "Reset computer" [testid=computer-reset, title="Close the shared desktop and wipe its settings (every bot on it)"]
      icon lucide-rotate-ccw
    button "Close computer panel" [title="Close panel"]
      icon lucide-x
  div [testid=computer-takeover-reason]
    icon lucide-hand
    "Surfer asked you:"
    "Sign in to the mail app"
    "It sees nothing until you press I'm done."
  div [testid=computer-viewport]
    div [testid=computer-vnc]
    div [testid=computer-driving-frame, aria-hidden=true]"
`;

exports[`ComputerPanel states > not set up > markup 1`] = `
"<body>
  <div>
    <div
      class="flex flex-col fixed inset-0 z-40 bg-background xl:static xl:z-auto xl:h-full xl:w-[min(var(--computer-panel-width),calc(100vw-42rem))] xl:shrink-0 xl:bg-transparent xl:p-2 xl:pl-0"
      data-testid="computer-panel"
      style="--computer-panel-width: 360px;"
    >
      <div
        aria-label="Resize computer panel"
        aria-orientation="vertical"
        class="absolute inset-y-0 left-0 z-10 hidden w-1.5 -translate-x-1/2 cursor-col-resize hover:bg-border xl:block"
        role="separator"
      />
      <div
        class="group/card flex flex-col overflow-hidden rounded-2xl bg-card text-sm text-card-foreground ring-1 ring-foreground/10 [--card-spacing:--spacing(4)] has-data-[slot=card-footer]:pb-0 has-[>img:first-child]:pt-0 data-[size=sm]:[--card-spacing:--spacing(3)] data-[size=sm]:has-data-[slot=card-footer]:pb-0 *:[img:first-child]:rounded-t-2xl *:[img:last-child]:rounded-b-2xl min-h-0 flex-1 gap-0 py-0 max-xl:rounded-none max-xl:ring-0"
        data-size="sm"
        data-slot="card"
      >
        <header
          class="@container flex h-11 shrink-0 items-center gap-2 border-b pr-1.5 pl-2"
        >
          <div
            class="flex min-w-0 flex-1 items-center gap-2"
          >
            <h3
              class="font-heading font-medium group-data-[size=sm]/card:text-sm pl-1 text-sm"
              data-slot="card-title"
            >
              Computer
            </h3>
            <span
              aria-live="polite"
              class="inline-flex h-6 min-w-0 shrink items-center gap-1.5 rounded-full px-2 text-xs font-medium text-muted-foreground"
            >
              <span
                aria-hidden="true"
                class="relative flex size-1.5 shrink-0"
              >
                <span
                  class="relative size-1.5 rounded-full bg-muted-foreground"
                />
              </span>
              <span
                class="truncate"
              >
                Not set up
              </span>
            </span>
          </div>
          <div
            class="flex shrink-0 items-center gap-0.5"
          >
            <button
              aria-label="Close computer panel"
              class="group/button inline-flex shrink-0 items-center justify-center rounded-xl border border-transparent bg-clip-padding text-sm font-medium whitespace-nowrap transition-transform duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:scale-[0.97] motion-reduce:transition-none disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 hover:bg-muted aria-expanded:bg-muted aria-expanded:text-foreground dark:hover:bg-muted/50 size-7 in-data-[slot=button-group]:rounded-lg text-muted-foreground hover:text-foreground"
              data-size="icon-sm"
              data-slot="button"
              data-variant="ghost"
              title="Close panel"
            >
              <svg
                aria-hidden="true"
                class="lucide lucide-x size-3.5"
                fill="none"
                height="24"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="24"
                xmlns="http://www.w3.org/2000/svg"
              />
            </button>
          </div>
        </header>
        <div
          class="relative min-h-0 flex-1 overflow-hidden"
          data-testid="computer-viewport"
        >
          <div
            class="flex flex-col items-center justify-center px-6 text-center h-full py-6"
          >
            <div
              class="mb-3 flex size-12 items-center justify-center rounded-full bg-muted"
            >
              <svg
                aria-hidden="true"
                class="lucide lucide-monitor-off size-6 text-muted-foreground"
                fill="none"
                height="24"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="24"
                xmlns="http://www.w3.org/2000/svg"
              />
            </div>
            <p
              class="text-sm font-medium text-foreground"
            >
              No computer on this server.
            </p>
            <p
              class="mt-1 text-xs text-muted-foreground"
            >
              <span
                class="mx-auto block max-w-sm"
                data-testid="computer-setup-hint"
              >
                Set SANDBOX_HOST to give bots a computer on the sandbox VM.
              </span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>"
`;

