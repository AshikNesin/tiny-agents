exports[`Browser page states > a bot's own browser, by deep link > markup 1`] = `
"<body>
  <div>
    <div
      class="max-w-full mx-auto "
    >
      <div
        class="grid grid-cols-[minmax(0,1fr)_auto] items-start gap-x-4"
      >
        <div
          class="col-start-1 row-start-1 min-w-0"
        >
          <div
            class="flex min-h-9 items-center gap-2.5"
          >
            <h1
              class="truncate text-xl font-semibold text-foreground sm:text-2xl"
            >
              Browser
            </h1>
          </div>
        </div>
        <div
          class="col-span-2 row-start-2 mt-1 text-sm text-muted-foreground md:col-span-1"
        >
          The bots' browsers on the sandbox VM. Click one to use it yourself; bots on it wait.
        </div>
      </div>
      <div
        class="mt-8 space-y-6"
      >
        <div
          class="flex flex-col overflow-hidden rounded-xl bg-background ring-1 ring-border md:h-[calc(100dvh-15rem)]"
          data-testid="browser-region"
        >
          <div
            class="@container flex min-h-11 shrink-0 flex-wrap items-center gap-x-2 gap-y-1 border-b px-1.5 py-1"
          >
            <div
              aria-label="Browsers"
              class="flex min-w-0 flex-1 items-center gap-0.5 overflow-x-auto @max-lg:basis-full"
              role="tablist"
            >
              <button
                aria-selected="false"
                class="flex h-7 shrink-0 items-center gap-1.5 rounded-md px-2.5 text-sm outline-none focus-visible:ring-3 focus-visible:ring-ring/50 text-muted-foreground hover:bg-muted/50 hover:text-foreground"
                data-testid="browser-tab-shared"
                role="tab"
                type="button"
              >
                <span
                  aria-hidden="true"
                  class="size-1.5 shrink-0 rounded-full bg-success"
                />
                <span
                  class="font-medium"
                >
                  Shared
                </span>
                <span
                  class="text-xs text-muted-foreground"
                >
                  2 bots
                </span>
              </button>
              <button
                aria-selected="true"
                class="flex h-7 shrink-0 items-center gap-1.5 rounded-md px-2.5 text-sm outline-none focus-visible:ring-3 focus-visible:ring-ring/50 bg-muted text-foreground"
                data-testid="browser-tab-bot-b3"
                role="tab"
                type="button"
              >
                <span
                  aria-hidden="true"
                  class="size-1.5 shrink-0 rounded-full bg-success"
                />
                <span
                  class="font-medium"
                >
                  Scout
                </span>
                <span
                  class="text-xs text-muted-foreground"
                >
                  own browser
                </span>
              </button>
            </div>
            <span
              aria-live="polite"
              class="inline-flex h-6 min-w-0 shrink items-center gap-1.5 rounded-full px-2 text-xs font-medium text-muted-foreground"
              data-testid="browser-page-status"
            >
              <span
                aria-hidden="true"
                class="relative flex size-1.5 shrink-0"
              >
                <span
                  class="relative size-1.5 rounded-full bg-success"
                />
              </span>
              <span
                class="truncate"
                data-testid="browser-page-driver"
              >
                Scout is driving
              </span>
            </span>
            <div
              class="ml-auto flex shrink-0 items-center gap-0.5"
            >
              <button
                aria-label="Full screen"
                class="group/button inline-flex shrink-0 items-center justify-center rounded-xl border border-transparent bg-clip-padding text-sm font-medium whitespace-nowrap transition-transform duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:scale-[0.97] motion-reduce:transition-none disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 hover:bg-muted aria-expanded:bg-muted aria-expanded:text-foreground dark:hover:bg-muted/50 size-7 in-data-[slot=button-group]:rounded-lg text-muted-foreground hover:text-foreground"
                data-size="icon-sm"
                data-slot="button"
                data-testid="browser-page-fullscreen"
                data-variant="ghost"
                title="Full screen"
              >
                <svg
                  aria-hidden="true"
                  class="lucide lucide-maximize-2 size-3.5"
                  fill="none"
                  height="24"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  width="24"
                  xmlns="http://www.w3.org/2000/svg"
                />
              </button>
              <button
                aria-label="Reset browser"
                class="group/button inline-flex shrink-0 items-center justify-center rounded-xl border border-transparent bg-clip-padding text-sm font-medium whitespace-nowrap transition-transform duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:scale-[0.97] motion-reduce:transition-none disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 hover:bg-muted aria-expanded:bg-muted aria-expanded:text-foreground dark:hover:bg-muted/50 size-7 in-data-[slot=button-group]:rounded-lg text-muted-foreground hover:text-foreground"
                data-size="icon-sm"
                data-slot="button"
                data-testid="browser-page-reset"
                data-variant="ghost"
                title="Close this browser and wipe its profile"
              >
                <svg
                  aria-hidden="true"
                  class="lucide lucide-rotate-ccw size-3.5"
                  fill="none"
                  height="24"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  width="24"
                  xmlns="http://www.w3.org/2000/svg"
                />
              </button>
            </div>
          </div>
          <div
            class="relative w-full flex-1 overflow-hidden rounded-b-[inherit] h-[60vh] min-h-[320px] md:h-auto md:min-h-0"
            data-testid="browser-page-viewport"
          >
            <div
              class="bg-muted absolute inset-0"
              data-testid="browser-vnc"
            />
            <button
              aria-label="Take control"
              class="group absolute inset-0 flex cursor-pointer items-end justify-center pb-4 outline-none hover:bg-foreground/5 focus-visible:bg-foreground/5"
              data-testid="browser-page-take"
              title="Click and type in this browser yourself. Bots on it wait."
              type="button"
            >
              <span
                class="flex items-center gap-1.5 rounded-full bg-foreground/85 px-3 py-1.5 text-xs font-medium text-background opacity-0 shadow-lg backdrop-blur-sm transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100 pointer-coarse:opacity-100"
              >
                <svg
                  aria-hidden="true"
                  class="lucide lucide-mouse-pointer-click size-3.5"
                  fill="none"
                  height="24"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  width="24"
                  xmlns="http://www.w3.org/2000/svg"
                />
                Click to take control
              </span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>"
`;

