exports[`Routines page, pinned > the editor for a weekday cron > markup 1`] = `
"<body>
  <div
    data-base-ui-inert=""
  >
    <div
      aria-hidden="true"
      class="max-w-4xl mx-auto "
    >
      <div
        class="grid grid-cols-[minmax(0,1fr)_auto] items-start gap-x-4"
      >
        <div
          class="col-start-1 row-start-1 min-w-0"
        >
          <div
            class="flex min-h-9 items-center gap-2.5"
          >
            <h1
              class="truncate text-xl font-semibold text-foreground sm:text-2xl"
            >
              Routines
            </h1>
          </div>
        </div>
        <div
          class="col-span-2 row-start-2 mt-1 text-sm text-muted-foreground md:col-span-1"
        >
          Run any bot on a schedule (once, daily, weekly, on an interval) or when a webhook is called. Times are in IST.
        </div>
        <div
          class="col-start-2 row-start-1 flex flex-shrink-0 items-center gap-2 md:row-span-2"
