{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {
      "@groot/ai": ["./packages/ai/src/index.ts"],
      "@groot/ai/*": ["./packages/ai/src/*"],
      "@groot/ui/*": ["./packages/ui/src/*"],
      "@groot/shell/*": ["./packages/shell/src/*"],
      "@groot/core/*": ["./packages/core/src/*"],
      "@groot/jobs/server": ["./packages/jobs/src/server/index.ts"],
      "@groot/jobs/server/*": ["./packages/jobs/src/server/*"],
      "@groot/jobs/client": ["./packages/jobs/src/client/index.ts"],
      "@groot/jobs/client/*": ["./packages/jobs/src/client/*"],
      "@tiny-agents/agent": ["./packages/agent/src/index.ts"],
      "@tiny-agents/agent/sandbox": ["./packages/agent/src/subpaths/sandbox.ts"],
      "@tiny-agents/agent/terminal": ["./packages/agent/src/subpaths/terminal.ts"],
      "@tiny-agents/agent/browser": ["./packages/agent/src/subpaths/browser.ts"],
      "@tiny-agents/agent/computer": ["./packages/agent/src/subpaths/computer.ts"],
      "@tiny-agents/agent/claude-worker": ["./packages/agent/src/subpaths/claude-worker.ts"],
      "@tiny-agents/agent/peer-envelope": ["./packages/agent/src/toolkits/peer-envelope.ts"],
      "@tiny-agents/agent/testing": ["./packages/agent/src/testing.ts"],
      "@tiny-agents/claude-worker": ["./packages/claude-worker/src/index.ts"],
      "@tiny-agents/code/contracts": ["./packages/code/src/contracts/index.ts"],
      "@tiny-agents/code/server": ["./packages/code/src/server/index.ts"],
      "@tiny-agents/code/testing": ["./packages/code/src/testing.ts"]
    }
  },
  "include": [
    "apps/web/src/server/**/*",
    "packages/ai/src/**/*",
    "packages/core/src/**/*",
    "packages/jobs/src/server/**/*",
    "packages/agent/src/**/*",
    "packages/claude-worker/src/**/*",
    "packages/code/src/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
